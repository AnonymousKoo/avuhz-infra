{
  "policy_id": "oia-finding-priority",
  "policy_version": "1.0.0",
  "status": "FROZEN",
  "input_contract": {
    "schema_reference": "urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/priorityInputs",
    "fields": {
      "impact": {
        "schema_reference": "urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/impact",
        "semantic_order_low_to_high": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
      },
      "urgency": {
        "schema_reference": "urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/urgency",
        "semantic_order_low_to_high": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
      },
      "operational_criticality": {
        "schema_reference": "urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/operationalCriticality",
        "semantic_order_low_to_high": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
      },
      "confidence": {
        "schema_reference": "urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/confidence",
        "semantic_order_low_to_high": ["LOW", "MEDIUM", "HIGH"]
      },
      "dependency_blocking": {
        "type": "boolean",
        "semantic_order_low_to_high": [false, true]
      }
    }
  },
  "output_contract": {
    "schema_reference": "urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/priority",
    "semantic_order_low_to_high": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
  },
  "preconditions": [
    "AUTHORITATIVE_PRIORITY_INPUTS_VALID",
    "DIAGNOSTIC_SUPPORT_CHAIN_VALID"
  ],
  "rules": {
    "consequence_base": {
      "operator": "MAX_SEMANTIC_TIER",
      "inputs": ["impact", "operational_criticality"]
    },
    "base_priority_by_consequence": {
      "LOW": "LOW",
      "MEDIUM": "MEDIUM",
      "HIGH": "HIGH",
      "CRITICAL": "HIGH"
    },
    "urgency_escalation_by_tier": {
      "LOW": "NO_CHANGE",
      "MEDIUM": "NO_CHANGE",
      "HIGH": "ONE_TIER",
      "CRITICAL": "ONE_TIER"
    },
    "dependency_blocking_escalation": {
      "false": "NO_CHANGE",
      "true": "ONE_TIER"
    },
    "ordinary_escalation_ceiling": "HIGH",
    "critical_gate": {
      "all": {
        "consequence_base": "CRITICAL",
        "urgency": "CRITICAL",
        "confidence": "HIGH",
        "diagnostic_support_chain": "VALID"
      },
      "dependency_blocking_required": false
    },
    "confidence_ceiling": {
      "LOW": "MEDIUM",
      "MEDIUM": "HIGH",
      "HIGH": "CRITICAL"
    },
    "evaluation_order": [
      "VALIDATE_INPUTS_AND_PRECONDITIONS",
      "DERIVE_CONSEQUENCE_BASE",
      "MAP_BASE_PRIORITY",
      "APPLY_URGENCY_ESCALATION_WITH_ORDINARY_CEILING",
      "APPLY_DEPENDENCY_ESCALATION_WITH_ORDINARY_CEILING",
      "EVALUATE_CRITICAL_GATE_SEPARATELY",
      "APPLY_CONFIDENCE_CEILING",
      "RETURN_ONE_PRIORITY"
    ],
    "tie_behavior": "EVALUATION_ORDER_IS_AUTHORITATIVE"
  }
}
