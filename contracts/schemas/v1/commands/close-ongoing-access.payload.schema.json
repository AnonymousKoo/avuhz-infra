{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:avuhz:schema:contracts:commands:close-ongoing-access-payload:v1","title":"Close Ongoing Access Payload v1",
  "description":"Reconciles one ongoing grant to CLOSED from an authoritative server-resolved commercial or offboarding source. It does not accept arbitrary closure reasons.",
  "type":"object","additionalProperties":false,"required":["ongoing_access_grant_id","closure_reason","closure_source_reference"],
  "properties":{
    "ongoing_access_grant_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAccessGrantId"},
    "closure_reason":{"type":"string","enum":["AGREEMENT_ENDED","COMMERCIAL_AUTHORITY_INVALID","OFFBOARDING_COMPLETED","ENGAGEMENT_COMPLETED"]},
    "closure_source_reference":{"oneOf":[{"$ref":"urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingAgreementReference"},{"$ref":"urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingPaymentReference"},{"$ref":"urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/offboardingReference"}]}
  }
}
