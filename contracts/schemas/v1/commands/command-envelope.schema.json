{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:commands:command-envelope:v1",
  "title": "Avuhz Governed Command Envelope v1",
  "description": "Strict provider-neutral command envelope. Caller claims are not authority; trusted execution context, capability, tenant, version, and idempotency checks remain mandatory.",
  "allOf": [
    {
      "$ref": "#/$defs/envelopeCore"
    },
    {
      "type": "object",
      "required": [
        "payload"
      ],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "commandType": {
      "type": "string",
      "enum": [
        "AcceptAcquisitionHandoff",
        "OpenEngagement",
        "DraftImplementationBrief",
        "ReviseImplementationBrief",
        "RecordImplementationBriefApproval",
        "ApproveImplementationBrief",
        "ProposeImplementationAuthorization",
        "ReviseImplementationAuthorization",
        "RecordImplementationAuthorizationApproval",
        "ActivateImplementationAuthorization",
        "RevokeImplementationAuthorization",
        "DraftCodexBuildPackage",
        "ReviseCodexBuildPackage",
        "RecordCodexBuildPackageApproval",
        "ReleaseCodexBuildPackage",
        "StartBuildExecution",
        "CompleteBuildExecution",
        "RecordQAResult",
        "RecordClientAcceptance",
        "ProposeDeploymentAuthorization",
        "ReviseDeploymentAuthorization",
        "RecordDeploymentAuthorizationApproval",
        "ActivateDeploymentAuthorization",
        "RevokeDeploymentAuthorization",
        "StartDeploymentExecution",
        "CompleteDeploymentExecution",
        "RecordDeploymentVerification"
      ]
    },
    "subjectType": {
      "type": "string",
      "enum": [
        "ACQUISITION_HANDOFF",
        "ENGAGEMENT",
        "IMPLEMENTATION_BRIEF",
        "IMPLEMENTATION_AUTHORIZATION",
        "CODEX_BUILD_PACKAGE",
        "BUILD_EXECUTION_RESULT",
        "QA_RESULT",
        "CLIENT_ACCEPTANCE",
        "DEPLOYMENT_AUTHORIZATION",
        "DEPLOYMENT_EXECUTION",
        "DEPLOYMENT_VERIFICATION"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "positiveRecordVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "envelopeCore": {
      "type": "object",
      "required": [
        "command_id",
        "command_type",
        "command_schema_version",
        "tenant_id",
        "subject_type",
        "subject_id",
        "requested_by",
        "caller_type",
        "caller_identity",
        "correlation_id",
        "idempotency_key",
        "requested_at",
        "environment",
        "payload_schema",
        "payload_version"
      ],
      "properties": {
        "command_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/commandId"
        },
        "command_type": {
          "$ref": "#/$defs/commandType"
        },
        "command_schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "tenant_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
        },
        "engagement_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
        },
        "subject_type": {
          "$ref": "#/$defs/subjectType"
        },
        "subject_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
        },
        "expected_record_version": {
          "$ref": "#/$defs/positiveRecordVersion"
        },
        "requested_by": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
        },
        "caller_type": {
          "$ref": "urn:avuhz:schema:contracts:identity:caller-type:v1"
        },
        "caller_identity": {
          "$ref": "urn:avuhz:schema:contracts:identity:caller-identity:v1"
        },
        "authority_reference": {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"
        },
        "correlation_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/correlationId"
        },
        "causation_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/causationId"
        },
        "idempotency_key": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"
        },
        "requested_at": {
          "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
        },
        "environment": {
          "$ref": "urn:avuhz:schema:contracts:common:environment:v1#/$defs/environment"
        },
        "payload_schema": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/schemaIdentifier"
        },
        "payload_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "AcceptAcquisitionHandoff"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "ACQUISITION_HANDOFF"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "OpenEngagement"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "ENGAGEMENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "DraftImplementationBrief"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_BRIEF"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ReviseImplementationBrief"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_BRIEF"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordImplementationBriefApproval"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_BRIEF"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ApproveImplementationBrief"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_BRIEF"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ProposeImplementationAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ReviseImplementationAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordImplementationAuthorizationApproval"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ActivateImplementationAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RevokeImplementationAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "IMPLEMENTATION_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "DraftCodexBuildPackage"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "CODEX_BUILD_PACKAGE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ReviseCodexBuildPackage"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "CODEX_BUILD_PACKAGE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordCodexBuildPackageApproval"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "CODEX_BUILD_PACKAGE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ReleaseCodexBuildPackage"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "CODEX_BUILD_PACKAGE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "StartBuildExecution"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "BUILD_EXECUTION_RESULT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "CompleteBuildExecution"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "BUILD_EXECUTION_RESULT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordQAResult"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "QA_RESULT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordClientAcceptance"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "CLIENT_ACCEPTANCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ProposeDeploymentAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ReviseDeploymentAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordDeploymentAuthorizationApproval"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "ActivateDeploymentAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RevokeDeploymentAuthorization"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_AUTHORIZATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "StartDeploymentExecution"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_EXECUTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "CompleteDeploymentExecution"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_EXECUTION"
              }
            },
            "required": [
              "expected_record_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command_type": {
                "const": "RecordDeploymentVerification"
              }
            },
            "required": [
              "command_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "DEPLOYMENT_VERIFICATION"
              }
            }
          }
        }
      ]
    }
  }
}
