{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:commands:command-envelope:v1",
  "title": "Avuhz Slice 1 Command Envelope v1",
  "description": "Strict transport envelope for a requested Slice 1 command. Caller-supplied identity is never proof: the server must derive and verify authenticated identity, caller type, capabilities, tenant membership, audience, effective authority, and server time. This base envelope is not sufficient to validate or execute a command until a registered command-specific payload schema composes the reusable envelope core.",
  "allOf": [
    {
      "$ref": "#/$defs/envelopeCore"
    },
    {
      "type": "object",
      "required": [
        "payload"
      ],
      "properties": {
        "payload": {
          "description": "Temporary empty placeholder. Arbitrary payload content is rejected until a command-specific payload schema is registered and composed with envelopeCore.",
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
