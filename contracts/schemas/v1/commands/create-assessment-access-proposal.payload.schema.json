{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:commands:create-assessment-access-proposal-payload:v1",
  "title": "Create Assessment Access Proposal Payload v1",
  "description": "Strict request to propose bounded assessment access from existing authoritative diagnostic scope and commercial records. Authority digest, lifecycle state, human approvals, identity, credentials, provider data, and metadata are server-derived or forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_access_proposal_id",
    "engagement_id",
    "diagnostic_scope_id",
    "scope_version",
    "diagnostic_agreement_authority_reference",
    "diagnostic_payment_verification_reference",
    "target_system_references",
    "permitted_actions"
  ],
  "properties": {
    "assessment_access_proposal_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/assessmentAccessProposalId"},
    "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "diagnostic_scope_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"},
    "scope_version": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/$defs/positiveVersion"},
    "diagnostic_agreement_authority_reference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_AGREEMENT_AUTHORITY"}}}]},
    "diagnostic_payment_verification_reference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_PAYMENT_VERIFICATION"}}}]},
    "target_system_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 20,
      "items": {"type": "object", "additionalProperties": false, "required": ["system_reference_id"], "properties": {"system_reference_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"}}}
    },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 10,
      "items": {"type": "string", "enum": ["VIEW_CONFIGURATION", "VIEW_OPERATIONAL_STATE", "VIEW_LOGS", "VIEW_METRICS", "VIEW_ACCESS_CONFIGURATION", "VIEW_NETWORK_CONFIGURATION", "VIEW_SECURITY_CONFIGURATION", "VIEW_COMPLIANCE_EVIDENCE", "NON_DESTRUCTIVE_CONNECTIVITY_TEST", "NON_DESTRUCTIVE_PERMISSION_TEST"]}
    }
  }
}
