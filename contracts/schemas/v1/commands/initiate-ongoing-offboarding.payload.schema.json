{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:avuhz:schema:contracts:commands:initiate-ongoing-offboarding-payload:v1","title":"Initiate Ongoing Offboarding Payload v1",
  "description":"Initiates non-destructive offboarding for one exact conversion and any exact ongoing authority records. Initiation immediately denies future ongoing eligibility but does not claim external access removal.",
  "type":"object","additionalProperties":false,
  "required":["ongoing_offboarding_id","oia_conversion_decision_id","decision_version","reason","ongoing_access_grant_ids"],
  "properties":{
    "ongoing_offboarding_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingOffboardingId"},
    "oia_conversion_decision_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaConversionDecisionId"},
    "decision_version":{"$ref":"urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "ongoing_agreement_authority_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAgreementAuthorityId"},
    "agreement_version":{"$ref":"urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "reason":{"type":"string","enum":["CONVERSION_DECLINED","AGREEMENT_ENDED","CLIENT_TERMINATION","SEKINFRA_TERMINATION","ENGAGEMENT_COMPLETED"]},
    "ongoing_access_grant_ids":{"type":"array","minItems":0,"maxItems":20,"uniqueItems":true,"items":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAccessGrantId"}}
  },
  "allOf":[
    {"if":{"required":["ongoing_agreement_authority_id"]},"then":{"required":["agreement_version"]}},
    {"if":{"properties":{"reason":{"const":"CONVERSION_DECLINED"}},"required":["reason"]},"then":{"properties":{"ongoing_access_grant_ids":{"maxItems":0}},"not":{"required":["ongoing_agreement_authority_id"]}}}
  ]
}
