{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:commands:submit-diagnostic-scope-payload:v1",
  "title": "Submit Diagnostic Scope Payload v1",
  "description": "Strict content for requesting a new DiagnosticScope version under an existing Engagement. A successful command is expected to create REVIEW_PENDING content; this payload cannot include approval state, authority, commercial, access, implementation, or deployment data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposed_diagnostic_scope_id", "scope_version", "target_outcome", "in_scope_systems", "excluded_systems", "permitted_diagnostic_actions", "prohibited_actions", "assumptions", "constraints"],
  "properties": {
    "proposed_diagnostic_scope_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"},
    "scope_version": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/$defs/positiveVersion"},
    "target_outcome": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/target_outcome"},
    "in_scope_systems": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/in_scope_systems"},
    "excluded_systems": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/excluded_systems"},
    "permitted_diagnostic_actions": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/permitted_diagnostic_actions"},
    "prohibited_actions": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/prohibited_actions"},
    "assumptions": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/assumptions"},
    "constraints": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/properties/constraints"},
    "supersedes_reference": {"$ref": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1#/$defs/scopeReference"}
  }
}
