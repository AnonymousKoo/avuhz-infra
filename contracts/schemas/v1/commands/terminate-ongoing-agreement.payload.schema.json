{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:avuhz:schema:contracts:commands:terminate-ongoing-agreement-payload:v1","title":"Terminate Ongoing Agreement Payload v1",
  "description":"Requests one bounded Agreement #2 terminal transition. Trusted actor authority and resulting state are server-validated; termination never deletes history.",
  "type":"object","additionalProperties":false,"required":["ongoing_agreement_authority_id","agreement_version","termination_reason"],
  "properties":{
    "ongoing_agreement_authority_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAgreementAuthorityId"},
    "agreement_version":{"$ref":"urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "termination_reason":{"type":"string","enum":["TERM_ENDED","ENGAGEMENT_COMPLETED","CLIENT_TERMINATION","SEKINFRA_TERMINATION","AUTHORITY_REVOKED"]}
  }
}
