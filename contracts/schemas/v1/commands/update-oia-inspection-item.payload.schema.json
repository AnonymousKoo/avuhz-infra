{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:avuhz:schema:contracts:commands:update-oia-inspection-item-payload:v1","title":"UpdateOIAInspectionItem Payload v1","description":"Records one bounded inspection progress/sufficiency transition; it never proves or finalizes a Finding.","type":"object","additionalProperties":false,"required":["oia_inspection_item_id","coverage_state","sufficiency_evaluation","limitations","linked_evidence_ids"],"properties":{"oia_inspection_item_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaInspectionItemId"},"coverage_state":{"enum":["IN_PROGRESS","PARTIALLY_EVIDENCED","SUFFICIENTLY_EVIDENCED","NOT_APPLICABLE"]},"sufficiency_evaluation":{"$ref":"urn:avuhz:schema:contracts:domain:oia-methodology-common:v1#/$defs/sufficiencyEvaluation"},"limitations":{"type":"array","maxItems":20,"items":{"$ref":"urn:avuhz:schema:contracts:domain:oia-methodology-common:v1#/$defs/limitation"}},"stop_reason":{"$ref":"urn:avuhz:schema:contracts:domain:oia-methodology-common:v1#/$defs/stopReason"},"stop_rationale":{"type":"string","minLength":10,"maxLength":1000},"intervention_class":{"$ref":"urn:avuhz:schema:contracts:domain:oia-methodology-common:v1#/$defs/interventionClass"},"linked_evidence_ids":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaEvidenceId"}},"assessor_notes":{"type":"string","minLength":1,"maxLength":2000}},"allOf":[{"if":{"properties":{"coverage_state":{"const":"NOT_APPLICABLE"}},"required":["coverage_state"]},"then":{"required":["stop_reason","stop_rationale"]}}]}
