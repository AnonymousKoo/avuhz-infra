{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:assessment-access-grant:v1",
  "title": "Avuhz Assessment Access Grant v1",
  "description": "Authoritative temporary diagnostic-only access authority for explicitly bounded systems and permitted assessment actions. It is authorization metadata only: never a credential, secret, vault record, ongoing access, implementation authority, deployment authority, or production-change authority.",
  "type": "object", "additionalProperties": false,
  "required": ["assessment_access_grant_id", "tenant_id", "engagement_id", "source_assessment_access_proposal_reference", "diagnostic_scope_reference", "canonical_scope_digest", "assessment_access_authority_digest", "action_set_version", "diagnostic_agreement_authority_reference", "diagnostic_payment_verification_reference", "target_system_references", "permitted_actions", "status", "approved_at", "record_version"],
  "properties": {
    "assessment_access_grant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/assessmentAccessGrantId"},
    "tenant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "source_assessment_access_proposal_reference": {"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"},
    "diagnostic_scope_reference": {"readOnly": true, "$ref": "#/$defs/diagnosticScopeReference"},
    "canonical_scope_digest": {"readOnly": true, "$ref": "#/$defs/canonicalScopeDigest"},
    "assessment_access_authority_digest": {"readOnly": true, "$ref": "#/$defs/canonicalScopeDigest"},
    "action_set_version": {"readOnly": true, "$ref": "#/$defs/positiveVersion"},
    "diagnostic_agreement_authority_reference": {"readOnly": true, "$ref": "#/$defs/diagnosticAgreementAuthorityReference"},
    "diagnostic_payment_verification_reference": {"readOnly": true, "$ref": "#/$defs/diagnosticPaymentVerificationReference"},
    "target_system_references": {"readOnly": true, "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/targetSystemReference"}},
    "permitted_actions": {"readOnly": true, "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/permittedDiagnosticAction"}},
    "status": {"type": "string", "enum": ["APPROVED", "ACTIVE", "EXPIRED", "REVOKED", "CLOSED"]},
    "approved_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "verified_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "active_from": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "expires_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "revoked_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "closed_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "closure_reason": {"readOnly": true, "type": "string", "enum": ["FINDINGS_DELIVERED", "ASSESSMENT_CLOSED", "AGREEMENT_ENDED"]},
    "record_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
  },
  "$defs": {
    "positiveVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "canonicalScopeDigest": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[a-f0-9]{64}$"},
    "diagnosticScopeReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}]},
    "diagnosticAgreementAuthorityReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_AGREEMENT_AUTHORITY"}}}]},
    "diagnosticPaymentVerificationReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_PAYMENT_VERIFICATION"}}}]},
    "targetSystemReference": {"type": "object", "additionalProperties": false, "required": ["system_reference_id"], "properties": {"system_reference_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"}}},
    "permittedDiagnosticAction": {"type": "string", "enum": ["VIEW_CONFIGURATION", "VIEW_OPERATIONAL_STATE", "VIEW_LOGS", "VIEW_METRICS", "VIEW_ACCESS_CONFIGURATION", "VIEW_NETWORK_CONFIGURATION", "VIEW_SECURITY_CONFIGURATION", "VIEW_COMPLIANCE_EVIDENCE", "NON_DESTRUCTIVE_CONNECTIVITY_TEST", "NON_DESTRUCTIVE_PERMISSION_TEST"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ACTIVE"}}, "required": ["status"]}, "then": {"required": ["verified_at", "active_from", "expires_at"]}},
    {"if": {"properties": {"status": {"const": "EXPIRED"}}, "required": ["status"]}, "then": {"required": ["verified_at", "active_from", "expires_at"]}},
    {"if": {"properties": {"status": {"const": "REVOKED"}}, "required": ["status"]}, "then": {"required": ["revoked_at"]}},
    {"if": {"properties": {"status": {"const": "CLOSED"}}, "required": ["status"]}, "then": {"required": ["closed_at", "closure_reason"]}, "else": {"not": {"anyOf": [{"required": ["closed_at"]}, {"required": ["closure_reason"]}]}}}
  ]
}
