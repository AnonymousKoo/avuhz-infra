  "properties": {
    "codex_build_package_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/codexBuildPackageId"}, "package_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/positiveVersion"}, "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"}, "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"}, "implementation_brief_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationBriefReference"}, "implementation_brief_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"}, "implementation_authorization_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationAuthorizationReference"}, "implementation_authority_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"},
    "authorized_build_scope": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/scopeItems"}, "problem_statement": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/boundedStatement"}, "desired_outcome": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/boundedStatement"}, "current_architecture_context": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/contextItems"}, "required_integrations": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/integrations"}, "implementation_requirements": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/scopeItems"}, "acceptance_criteria": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/acceptanceCriteria"}, "constraints": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/boundedStatements"}, "prohibited_changes": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/requiredProhibitedActions"}, "allowed_targets": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/targetReferences"}, "test_obligations": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/boundedStatements"}, "rollback_recovery_expectations": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/boundedStatements"},
    "client_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/humanApprovalReference"}, "sekinfra_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/humanApprovalReference"}, "package_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"}, "state": {"type": "string", "enum": ["DRAFT", "RELEASED", "SUPERSEDED"]}, "supersedes_codex_build_package_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/codexBuildPackageReference"}, "trusted_attribution": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/trustedAttribution"}, "released_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "record_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/positiveVersion"}, "created_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "updated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}
  },
  "allOf": [{"if": {"properties": {"state": {"enum": ["RELEASED", "SUPERSEDED"]}}, "required": ["state"]}, "then": {"required": ["client_approval_reference", "sekinfra_approval_reference", "released_at"]}}, {"if": {"properties": {"package_version": {"minimum": 2}}, "required": ["package_version"]}, "then": {"required": ["supersedes_codex_build_package_reference"]}}]
