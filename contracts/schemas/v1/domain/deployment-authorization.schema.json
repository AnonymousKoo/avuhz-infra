{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:deployment-authorization:v1",
  "title": "DeploymentAuthorization v1",
  "description": "Separate exact artifact, environment, target, action, and time-bounded deployment authority. Active authority is not deployment execution or blanket production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment_authorization_id",
    "authorization_version",
    "tenant_id",
    "engagement_id",
    "implementation_authorization_reference",
    "implementation_authority_digest",
    "codex_build_package_reference",
    "package_digest",
    "build_execution_reference",
    "build_execution_digest",
    "qa_result_reference",
    "qa_result_digest",
    "client_acceptance_reference",
    "client_acceptance_digest",
    "artifact_reference",
    "target_environment",
    "target_resources",
    "permitted_deployment_actions",
    "prohibited_deployment_actions",
    "rollback_recovery_requirement",
    "effective_at",
    "expires_at",
    "deployment_authority_digest",
    "state",
    "record_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "deployment_authorization_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/deploymentAuthorizationId"
    },
    "authorization_version": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/positiveVersion"
    },
    "implementation_authorization_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/implementationAuthorizationReference"
    },
    "implementation_authority_digest": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"
    },
    "codex_build_package_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/codexBuildPackageReference"
    },
    "package_digest": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"
    },
    "build_execution_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/buildExecutionReference"
    },
    "build_execution_digest": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"
    },
    "qa_result_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/qaResultReference"
    },
    "qa_result_digest": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"
    },
    "client_acceptance_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/clientAcceptanceReference"
    },
    "client_acceptance_digest": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"
    },
    "artifact_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/artifactReference"
    },
    "target_environment": {
      "type": "string",
      "enum": [
        "DEVELOPMENT",
        "TEST",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "target_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_reference_id",
          "target_class"
        ],
        "properties": {
          "target_reference_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
          },
          "target_class": {
            "type": "string",
            "enum": [
              "SYSTEM",
              "SERVICE",
              "COMPONENT",
              "HOST_GROUP"
            ]
          }
        }
      }
    },
    "permitted_deployment_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "DEPLOY_EXACT_ARTIFACT",
          "ROLLBACK_EXACT_ARTIFACT"
        ]
      }
    },
    "prohibited_deployment_actions": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/prohibitedDeploymentActions"
    },
    "rollback_recovery_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "verification_reference"
      ],
      "properties": {
        "strategy": {
          "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/boundedStatement"
        },
        "verification_reference": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
        }
      }
    },
    "effective_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "deployment_authority_digest": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"
    },
    "state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "client_approval_reference": {
      "allOf": [
        {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"
        },
        {
          "properties": {
            "reference_type": {
              "const": "HUMAN_APPROVAL"
            }
          }
        }
      ]
    },
    "sekinfra_approval_reference": {
      "allOf": [
        {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"
        },
        {
          "properties": {
            "reference_type": {
              "const": "HUMAN_APPROVAL"
            }
          }
        }
      ]
    },
    "activated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "revoked_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "revocation_reason": {
      "type": "string",
      "enum": [
        "CLIENT_WITHDRAWAL",
        "SEKINFRA_WITHDRAWAL",
        "ARTIFACT_INVALID",
        "QA_INVALID",
        "TARGET_CHANGED",
        "SECURITY_CONCERN",
        "IMPLEMENTATION_AUTHORITY_INVALID"
      ]
    },
    "supersedes_deployment_authorization_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/deploymentAuthorizationReference"
    },
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "record_version": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/positiveVersion"
    },
    "created_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "updated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "ACTIVE",
              "EXPIRED",
              "SUPERSEDED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "client_approval_reference",
          "sekinfra_approval_reference",
          "activated_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "REVOKED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "revoked_at",
          "revocation_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authorization_version": {
            "minimum": 2
          }
        },
        "required": [
          "authorization_version"
        ]
      },
      "then": {
        "required": [
          "supersedes_deployment_authorization_reference"
        ]
      }
    }
  ]
}
