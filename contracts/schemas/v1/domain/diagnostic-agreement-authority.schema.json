{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:diagnostic-agreement-authority:v1",
  "title": "Avuhz Diagnostic Agreement Authority v1",
  "description": "Authoritative provider-neutral record that a diagnostic/OIA engagement agreement has been verified. It records authority only, never a contract document, signature, provider payload, payment, credential, ongoing-service authority, or production-change authority.",
  "type": "object", "additionalProperties": false,
  "required": ["diagnostic_agreement_authority_id", "tenant_id", "engagement_id", "agreement_type", "agreement_reference", "status", "scope_reference", "canonical_scope_digest", "effective_at", "verified_at", "recorded_at", "record_version"],
  "properties": {
    "diagnostic_agreement_authority_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/diagnosticAgreementAuthorityId"},
    "tenant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "agreement_type": {"readOnly": true, "const": "DIAGNOSTIC_OIA"},
    "agreement_reference": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "status": {"type": "string", "enum": ["VERIFIED_ACTIVE", "EXPIRED", "REVOKED", "SUPERSEDED"]},
    "scope_reference": {"readOnly": true, "$ref": "#/$defs/diagnosticScopeReference"},
    "canonical_scope_digest": {"readOnly": true, "$ref": "#/$defs/canonicalScopeDigest"},
    "effective_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "ends_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "verified_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "recorded_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "record_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "supersedes_reference": {"$ref": "#/$defs/agreementAuthorityReference"}
  },
  "$defs": {
    "canonicalScopeDigest": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[a-f0-9]{64}$"},
    "diagnosticScopeReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}]},
    "agreementAuthorityReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_AGREEMENT_AUTHORITY"}}}]}
  }
}
