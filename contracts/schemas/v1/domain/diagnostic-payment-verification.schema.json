{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:diagnostic-payment-verification:v1",
  "title": "Avuhz Diagnostic Payment Verification v1",
  "description": "Authoritative provider-neutral record that required diagnostic/OIA payment has been verified as satisfied. It is not a payment processor, invoice, checkout session, receipt, agreement, or assessment-access authority; it never contains payment instruments, secrets, personally identifying billing data, or provider payloads.",
  "type": "object", "additionalProperties": false,
  "required": ["diagnostic_payment_verification_id", "tenant_id", "engagement_id", "diagnostic_agreement_authority_reference", "payment_purpose", "verification_status", "provider_reference", "amount_minor", "currency", "verified_at", "record_version"],
  "properties": {
    "diagnostic_payment_verification_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/diagnosticPaymentVerificationId"},
    "tenant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "diagnostic_agreement_authority_reference": {"readOnly": true, "$ref": "#/$defs/diagnosticAgreementAuthorityReference"},
    "payment_purpose": {"readOnly": true, "const": "DIAGNOSTIC_OIA"},
    "verification_status": {"type": "string", "enum": ["VERIFIED", "INVALIDATED"]},
    "provider_reference": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "amount_minor": {"readOnly": true, "type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "currency": {"readOnly": true, "type": "string", "pattern": "^[A-Z]{3}$"},
    "verified_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "invalidated_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "record_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
  },
  "$defs": {
    "diagnosticAgreementAuthorityReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_AGREEMENT_AUTHORITY"}}}]}
  },
  "allOf": [
    {"if": {"properties": {"verification_status": {"const": "INVALIDATED"}}, "required": ["verification_status"]}, "then": {"required": ["invalidated_at"]}},
    {"if": {"properties": {"verification_status": {"const": "VERIFIED"}}, "required": ["verification_status"]}, "then": {"not": {"required": ["invalidated_at"]}}}
  ]
}
