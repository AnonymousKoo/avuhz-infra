{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:diagnostic-scope:v1",
  "title": "Avuhz Slice 1 Diagnostic Scope v1",
  "description": "Versioned, allowlist-based diagnostic scope. Content becomes immutable after REVIEW_PENDING; material changes create a new version and supersede the prior scope. An APPROVED status requires future command guards to verify active, distinct client and Sekinfra approvals bound to this exact scope version and digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostic_scope_id", "engagement_id", "tenant_id", "scope_version", "record_version", "status", "target_outcome", "in_scope_systems", "excluded_systems", "permitted_diagnostic_actions", "prohibited_actions", "assumptions", "constraints", "effective_at", "created_at", "updated_at"],
  "properties": {
    "diagnostic_scope_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"},
    "engagement_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "tenant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "scope_version": {"$ref": "#/$defs/positiveVersion"},
    "record_version": {"$ref": "#/$defs/positiveVersion"},
    "status": {"type": "string", "enum": ["DRAFT", "REVIEW_PENDING", "APPROVED", "REJECTED", "SUPERSEDED", "CANCELLED"]},
    "target_outcome": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\u0000-\\u001F\\u007F]{1,2000}$"},
    "in_scope_systems": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/systemReference"}},
    "excluded_systems": {"type": "array", "minItems": 0, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/excludedSystem"}},
    "permitted_diagnostic_actions": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/permittedAction"}},
    "prohibited_actions": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/prohibitedAction"}},
    "assumptions": {"$ref": "#/$defs/boundedStatements"},
    "constraints": {"type": "array", "minItems": 0, "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/constraintReference"}},
    "client_approval_reference": {"$ref": "#/$defs/approvalReference"},
    "sekinfra_approval_reference": {"$ref": "#/$defs/approvalReference"},
    "effective_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "supersedes_reference": {"$ref": "#/$defs/scopeReference"},
    "created_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "updated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}
  },
  "$defs": {
    "positiveVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "systemTypeReference": {"type": "object", "additionalProperties": false, "required": ["taxonomy_source", "taxonomy_id"], "properties": {"taxonomy_source": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"}, "taxonomy_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"}, "taxonomy_version": {"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/externalVersion"}}},
    "canonicalAccountReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/externalReference"}, {"properties": {"object_type": {"const": "CANONICAL_ACCOUNT"}}}]},
    "systemReference": {"type": "object", "additionalProperties": false, "required": ["system_reference_id", "system_type", "account_reference", "environment"], "properties": {"system_reference_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"}, "system_type": {"$ref": "#/$defs/systemTypeReference"}, "account_reference": {"$ref": "#/$defs/canonicalAccountReference"}, "environment": {"$ref": "urn:avuhz:schema:contracts:common:environment:v1#/$defs/environment"}, "label": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\u0000-\\u001F\\u007F]{1,100}$"}}},
    "excludedSystem": {"type": "object", "additionalProperties": false, "required": ["system_reference", "reason"], "properties": {"system_reference": {"$ref": "#/$defs/systemReference"}, "reason": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F]{1,500}$"}}},
    "permittedAction": {"type": "string", "enum": ["VIEW_CONFIGURATION", "VIEW_OPERATIONAL_STATE", "VIEW_LOGS", "VIEW_METRICS", "VIEW_ACCESS_CONFIGURATION", "VIEW_NETWORK_CONFIGURATION", "VIEW_SECURITY_CONFIGURATION", "VIEW_COMPLIANCE_EVIDENCE", "NON_DESTRUCTIVE_CONNECTIVITY_TEST", "NON_DESTRUCTIVE_PERMISSION_TEST"]},
    "prohibitedAction": {"type": "string", "enum": ["CREATE", "MODIFY", "DELETE", "DEPLOY", "RESTART", "ROTATE", "GRANT", "REVOKE", "CHANGE_CONFIGURATION", "PRODUCTION_CHANGE"]},
    "boundedStatements": {"type": "array", "minItems": 0, "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F]{1,500}$"}},
    "constraintReference": {"oneOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"}, {"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/externalReference"}]},
    "approvalReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "HUMAN_APPROVAL"}}}]},
    "scopeReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "APPROVED"}}, "required": ["status"]}, "then": {"required": ["client_approval_reference", "sekinfra_approval_reference"]}},
    {"properties": {"prohibited_actions": {"contains": {"const": "CREATE"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "MODIFY"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "DELETE"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "DEPLOY"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "RESTART"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "ROTATE"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "GRANT"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "REVOKE"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "CHANGE_CONFIGURATION"}}}},
    {"properties": {"prohibited_actions": {"contains": {"const": "PRODUCTION_CHANGE"}}}}
  ]
}
