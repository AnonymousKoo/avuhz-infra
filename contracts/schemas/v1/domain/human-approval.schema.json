{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:human-approval:v1",
  "title": "Governed Human Approval v1",
  "description": "Separate attributable approval for an exact version and digest. Payload role claims never establish authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "tenant_id",
    "engagement_id",
    "subject_type",
    "subject_id",
    "subject_version",
    "approval_category",
    "authority_category",
    "actor_identity",
    "actor_organization",
    "actor_role",
    "decision",
    "phase5d_authority",
    "conditions",
    "effective_at",
    "evidence_reference",
    "status",
    "correlation_id",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "approval_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/approvalId"
    },
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "IMPLEMENTATION_BRIEF",
        "IMPLEMENTATION_AUTHORIZATION",
        "CODEX_BUILD_PACKAGE",
        "DEPLOYMENT_AUTHORIZATION"
      ]
    },
    "subject_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "subject_version": {
      "type": "integer",
      "minimum": 1
    },
    "approval_category": {
      "type": "string",
      "enum": [
        "IMPLEMENTATION_BRIEF",
        "IMPLEMENTATION_AUTHORIZATION",
        "CODEX_BUILD_PACKAGE",
        "DEPLOYMENT_AUTHORIZATION"
      ]
    },
    "authority_category": {
      "type": "string",
      "enum": [
        "CLIENT_AUTHORITY",
        "PROVIDER_AUTHORITY"
      ]
    },
    "actor_identity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "actor_organization": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "CLIENT_IMPLEMENTATION_AUTHORITY",
        "PROVIDER_IMPLEMENTATION_AUTHORITY",
        "CLIENT_DEPLOYMENT_AUTHORITY",
        "PROVIDER_DEPLOYMENT_AUTHORITY"
      ]
    },
    "decision": {
      "const": "APPROVE"
    },
    "phase5d_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "authority_digest"
      ],
      "properties": {
        "subject_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "effective_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "evidence_reference": {
      "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "correlation_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/correlationId"
    },
    "idempotency_key": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"
    },
    "created_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "IMPLEMENTATION_BRIEF",
              "IMPLEMENTATION_AUTHORIZATION",
              "CODEX_BUILD_PACKAGE"
            ]
          },
          "authority_category": {
            "const": "CLIENT_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "CLIENT_IMPLEMENTATION_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "IMPLEMENTATION_BRIEF",
              "IMPLEMENTATION_AUTHORIZATION",
              "CODEX_BUILD_PACKAGE"
            ]
          },
          "authority_category": {
            "const": "PROVIDER_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "PROVIDER_IMPLEMENTATION_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "DEPLOYMENT_AUTHORIZATION"
            ]
          },
          "authority_category": {
            "const": "CLIENT_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "CLIENT_DEPLOYMENT_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "DEPLOYMENT_AUTHORIZATION"
            ]
          },
          "authority_category": {
            "const": "PROVIDER_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "PROVIDER_DEPLOYMENT_AUTHORITY"
          }
        }
      }
    }
  ]
}
