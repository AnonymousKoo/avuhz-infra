{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:human-approval:v1",
  "title": "Avuhz Slice 1 Human Approval v1",
  "description": "Attributable human approval evidence for one exact DiagnosticScope version and content digest. Schema validation preserves evidence shape only; runtime authentication, authority, active-status, and tenant checks remain command-guard responsibilities. Client and Sekinfra authority are always separate records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "tenant_id", "engagement_id", "subject_type", "subject_id", "subject_version", "approval_category", "authority_category", "actor_identity", "actor_organization", "actor_role", "decision", "scope", "conditions", "effective_at", "evidence_reference", "status", "correlation_id", "idempotency_key", "created_at"],
  "properties": {
    "approval_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/approvalId"},
    "tenant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "subject_type": {"readOnly": true, "type": "string", "const": "DIAGNOSTIC_SCOPE"},
    "subject_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"},
    "subject_version": {"readOnly": true, "$ref": "#/$defs/positiveVersion"},
    "approval_category": {"readOnly": true, "type": "string", "const": "DIAGNOSTIC_SCOPE"},
    "authority_category": {"readOnly": true, "type": "string", "enum": ["CLIENT_AUTHORITY", "SEKINFRA_AUTHORITY"]},
    "actor_identity": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "actor_organization": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "actor_role": {"readOnly": true, "type": "string", "enum": ["CLIENT_DECISION_AUTHORITY", "SEKINFRA_ENGAGEMENT_AUTHORITY"]},
    "decision": {"readOnly": true, "type": "string", "enum": ["APPROVE", "REJECT", "REVOKE", "SUPERSEDE"]},
    "scope": {"readOnly": true, "$ref": "#/$defs/approvalScope"},
    "conditions": {"readOnly": true, "$ref": "#/$defs/conditions"},
    "effective_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "expires_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "evidence_reference": {"readOnly": true, "$ref": "#/$defs/evidenceReference"},
    "status": {"readOnly": true, "type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED", "SUPERSEDED"]},
    "supersedes_reference": {"readOnly": true, "$ref": "#/$defs/approvalReference"},
    "correlation_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/correlationId"},
    "idempotency_key": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"},
    "created_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}
  },
  "$defs": {
    "positiveVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "scopeDigest": {"description": "SHA-256 digest of canonical DiagnosticScope content, calculated by the trusted command service.", "type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "approvalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "subject_version", "scope_digest", "approved_action_set_version"],
      "properties": {
        "subject_type": {"type": "string", "const": "DIAGNOSTIC_SCOPE"},
        "subject_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"},
        "subject_version": {"$ref": "#/$defs/positiveVersion"},
        "scope_digest": {"$ref": "#/$defs/scopeDigest"},
        "approved_action_set_version": {"$ref": "#/$defs/positiveVersion"}
      }
    },
    "conditions": {"description": "Bounded human-readable conditions; no arbitrary structured metadata is permitted in Slice 1.", "type": "array", "minItems": 0, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\u0000-\\u001F\\u007F]{1,300}$"}},
    "evidenceReference": {"oneOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"}, {"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/externalReference"}]},
    "approvalReference": {"allOf": [{"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"}, {"properties": {"reference_type": {"const": "HUMAN_APPROVAL"}}}]}
  },
  "allOf": [
    {"if": {"properties": {"authority_category": {"const": "CLIENT_AUTHORITY"}}, "required": ["authority_category"]}, "then": {"properties": {"actor_role": {"const": "CLIENT_DECISION_AUTHORITY"}}}},
    {"if": {"properties": {"authority_category": {"const": "SEKINFRA_AUTHORITY"}}, "required": ["authority_category"]}, "then": {"properties": {"actor_role": {"const": "SEKINFRA_ENGAGEMENT_AUTHORITY"}}}},
    {"if": {"properties": {"decision": {"const": "REVOKE"}}, "required": ["decision"]}, "then": {"properties": {"status": {"const": "REVOKED"}}}},
    {"if": {"properties": {"decision": {"const": "SUPERSEDE"}}, "required": ["decision"]}, "then": {"properties": {"status": {"const": "SUPERSEDED"}}, "required": ["supersedes_reference"]}}
  ]
}
