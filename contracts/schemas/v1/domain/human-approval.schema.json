{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:human-approval:v1",
  "title": "Avuhz Human Approval v1",
  "description": "Attributable trusted-human approval evidence for one exact bounded authority projection. Runtime authentication, authority, active-status, tenant, and duplicate checks remain command-guard responsibilities. Client and Sekinfra authority are always separate records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "tenant_id",
    "engagement_id",
    "subject_type",
    "subject_id",
    "approval_category",
    "authority_category",
    "actor_identity",
    "actor_organization",
    "actor_role",
    "decision",
    "conditions",
    "effective_at",
    "evidence_reference",
    "status",
    "correlation_id",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "approval_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/approvalId"
    },
    "tenant_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "subject_type": {
      "readOnly": true,
      "type": "string",
      "enum": [
        "DIAGNOSTIC_SCOPE",
        "ASSESSMENT_ACCESS_PROPOSAL",
        "OIA_CONVERSION_DECISION",
        "ONGOING_AGREEMENT_AUTHORITY",
        "ONGOING_ACCESS_GRANT",
        "IMPLEMENTATION_BRIEF",
        "IMPLEMENTATION_AUTHORIZATION",
        "CODEX_BUILD_PACKAGE",
        "DEPLOYMENT_AUTHORIZATION"
      ]
    },
    "subject_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "subject_version": {
      "readOnly": true,
      "$ref": "#/$defs/positiveVersion"
    },
    "approval_category": {
      "readOnly": true,
      "type": "string",
      "enum": [
        "DIAGNOSTIC_SCOPE",
        "ASSESSMENT_ACCESS",
        "CONVERSION",
        "ONGOING_AGREEMENT",
        "ONGOING_ACCESS",
        "IMPLEMENTATION_BRIEF",
        "IMPLEMENTATION_AUTHORIZATION",
        "CODEX_BUILD_PACKAGE",
        "DEPLOYMENT_AUTHORIZATION"
      ]
    },
    "authority_category": {
      "readOnly": true,
      "type": "string",
      "enum": [
        "CLIENT_AUTHORITY",
        "SEKINFRA_AUTHORITY"
      ]
    },
    "actor_identity": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
    },
    "actor_organization": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
    },
    "actor_role": {
      "readOnly": true,
      "type": "string",
      "enum": [
        "CLIENT_DECISION_AUTHORITY",
        "SEKINFRA_ENGAGEMENT_AUTHORITY",
        "CLIENT_IMPLEMENTATION_AUTHORITY",
        "SEKINFRA_IMPLEMENTATION_AUTHORITY",
        "CLIENT_DEPLOYMENT_AUTHORITY",
        "SEKINFRA_DEPLOYMENT_AUTHORITY"
      ]
    },
    "decision": {
      "readOnly": true,
      "type": "string",
      "enum": [
        "APPROVE",
        "REJECT",
        "REVOKE",
        "SUPERSEDE"
      ]
    },
    "scope": {
      "readOnly": true,
      "$ref": "#/$defs/approvalScope"
    },
    "assessment_access": {
      "readOnly": true,
      "$ref": "#/$defs/assessmentAccessBinding"
    },
    "phase5c_authority": {
      "readOnly": true,
      "$ref": "#/$defs/phase5cAuthorityBinding"
    },
    "phase5d_authority": {
      "readOnly": true,
      "$ref": "#/$defs/phase5dAuthorityBinding"
    },
    "conditions": {
      "readOnly": true,
      "$ref": "#/$defs/conditions"
    },
    "effective_at": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "expires_at": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "evidence_reference": {
      "readOnly": true,
      "$ref": "#/$defs/evidenceReference"
    },
    "status": {
      "readOnly": true,
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "supersedes_reference": {
      "readOnly": true,
      "$ref": "#/$defs/approvalReference"
    },
    "correlation_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/correlationId"
    },
    "idempotency_key": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"
    },
    "created_at": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  },
  "$defs": {
    "positiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "authorityDigest": {
      "description": "SHA-256 digest of one exact immutable bounded authority projection, computed only by trusted future runtime.",
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scopeDigest": {
      "description": "SHA-256 digest of canonical DiagnosticScope content, calculated by the trusted command service.",
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approvalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id",
        "subject_version",
        "scope_digest",
        "approved_action_set_version"
      ],
      "properties": {
        "subject_type": {
          "type": "string",
          "const": "DIAGNOSTIC_SCOPE"
        },
        "subject_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"
        },
        "subject_version": {
          "$ref": "#/$defs/positiveVersion"
        },
        "scope_digest": {
          "$ref": "#/$defs/scopeDigest"
        },
        "approved_action_set_version": {
          "$ref": "#/$defs/positiveVersion"
        }
      }
    },
    "assessmentAccessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_access_proposal_id",
        "assessment_access_authority_digest"
      ],
      "properties": {
        "assessment_access_proposal_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/assessmentAccessProposalId"
        },
        "assessment_access_authority_digest": {
          "$ref": "#/$defs/authorityDigest"
        }
      }
    },
    "phase5cAuthorityBinding": {
      "description": "Exact digest-bound projection approved for conversion, Agreement #2, or ongoing access; it cannot carry document bodies, implementation design, or credentials.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "authority_digest"
      ],
      "properties": {
        "subject_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
        },
        "authority_digest": {
          "$ref": "#/$defs/authorityDigest"
        }
      }
    },
    "phase5dAuthorityBinding": {
      "description": "Exact digest-bound Phase 5D subject projection. It cannot approve deployment, production change, credentials, or arbitrary package content.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "authority_digest"
      ],
      "properties": {
        "subject_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
        },
        "authority_digest": {
          "$ref": "#/$defs/authorityDigest"
        }
      }
    },
    "conditions": {
      "description": "Bounded human-readable conditions; no arbitrary structured metadata is permitted.",
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[^\\u0000-\\u001F\\u007F]{1,300}$"
      }
    },
    "evidenceReference": {
      "oneOf": [
        {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"
        },
        {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/externalReference"
        }
      ]
    },
    "approvalReference": {
      "allOf": [
        {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/versionedInternalReference"
        },
        {
          "properties": {
            "reference_type": {
              "const": "HUMAN_APPROVAL"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "DIAGNOSTIC_SCOPE",
              "ASSESSMENT_ACCESS_PROPOSAL",
              "OIA_CONVERSION_DECISION",
              "ONGOING_AGREEMENT_AUTHORITY",
              "ONGOING_ACCESS_GRANT"
            ]
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "not": {
          "required": [
            "phase5d_authority"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "DIAGNOSTIC_SCOPE"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "DIAGNOSTIC_SCOPE"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/scopeId"
          }
        },
        "required": [
          "subject_version",
          "scope"
        ],
        "not": {
          "required": [
            "assessment_access"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "ASSESSMENT_ACCESS_PROPOSAL"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "ASSESSMENT_ACCESS"
          }
        },
        "required": [
          "assessment_access"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "subject_version"
              ]
            },
            {
              "required": [
                "scope"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "OIA_CONVERSION_DECISION"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "CONVERSION"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaConversionDecisionId"
          }
        },
        "required": [
          "subject_version",
          "phase5c_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "ONGOING_AGREEMENT_AUTHORITY"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "ONGOING_AGREEMENT"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAgreementAuthorityId"
          }
        },
        "required": [
          "subject_version",
          "phase5c_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "ONGOING_ACCESS_GRANT"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "ONGOING_ACCESS"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAccessGrantId"
          }
        },
        "required": [
          "subject_version",
          "phase5c_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "IMPLEMENTATION_BRIEF"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "IMPLEMENTATION_BRIEF"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/implementationBriefId"
          }
        },
        "required": [
          "subject_version",
          "phase5d_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            },
            {
              "required": [
                "phase5c_authority"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "IMPLEMENTATION_AUTHORIZATION"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "IMPLEMENTATION_AUTHORIZATION"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/implementationAuthorizationId"
          }
        },
        "required": [
          "subject_version",
          "phase5d_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            },
            {
              "required": [
                "phase5c_authority"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "CODEX_BUILD_PACKAGE"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "CODEX_BUILD_PACKAGE"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/codexBuildPackageId"
          }
        },
        "required": [
          "subject_version",
          "phase5d_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            },
            {
              "required": [
                "phase5c_authority"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "DIAGNOSTIC_SCOPE",
              "ASSESSMENT_ACCESS_PROPOSAL",
              "OIA_CONVERSION_DECISION",
              "ONGOING_AGREEMENT_AUTHORITY",
              "ONGOING_ACCESS_GRANT"
            ]
          },
          "authority_category": {
            "const": "CLIENT_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "CLIENT_DECISION_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "DIAGNOSTIC_SCOPE",
              "ASSESSMENT_ACCESS_PROPOSAL",
              "OIA_CONVERSION_DECISION",
              "ONGOING_AGREEMENT_AUTHORITY",
              "ONGOING_ACCESS_GRANT"
            ]
          },
          "authority_category": {
            "const": "SEKINFRA_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "SEKINFRA_ENGAGEMENT_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "IMPLEMENTATION_BRIEF",
              "IMPLEMENTATION_AUTHORIZATION",
              "CODEX_BUILD_PACKAGE"
            ]
          },
          "authority_category": {
            "const": "CLIENT_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "CLIENT_IMPLEMENTATION_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "enum": [
              "IMPLEMENTATION_BRIEF",
              "IMPLEMENTATION_AUTHORIZATION",
              "CODEX_BUILD_PACKAGE"
            ]
          },
          "authority_category": {
            "const": "SEKINFRA_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "SEKINFRA_IMPLEMENTATION_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REVOKE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "REVOKED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "SUPERSEDE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "SUPERSEDED"
          }
        },
        "required": [
          "supersedes_reference"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "DEPLOYMENT_AUTHORIZATION"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "approval_category": {
            "const": "DEPLOYMENT_AUTHORIZATION"
          },
          "subject_id": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/deploymentAuthorizationId"
          }
        },
        "required": [
          "subject_version",
          "phase5d_authority"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "assessment_access"
              ]
            },
            {
              "required": [
                "phase5c_authority"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "DEPLOYMENT_AUTHORIZATION"
          },
          "authority_category": {
            "const": "CLIENT_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "CLIENT_DEPLOYMENT_AUTHORITY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "DEPLOYMENT_AUTHORIZATION"
          },
          "authority_category": {
            "const": "SEKINFRA_AUTHORITY"
          }
        },
        "required": [
          "subject_type",
          "authority_category"
        ]
      },
      "then": {
        "properties": {
          "actor_role": {
            "const": "SEKINFRA_DEPLOYMENT_AUTHORITY"
          }
        }
      }
    }
  ]
}
