{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:avuhz:schema:contracts:domain:implementation-authorization:v1", "title": "ImplementationAuthorization v1",
  "description": "Separate bounded authority to perform exact non-production build activities for one approved ImplementationBrief version. It is not access, deployment, production-change, or managed-operations authority.",
  "type": "object", "additionalProperties": false,
  "required": ["implementation_authorization_id", "authorization_version", "tenant_id", "engagement_id", "implementation_brief_reference", "implementation_brief_digest", "source_conversion_decision_reference", "source_ongoing_agreement_reference", "source_ongoing_payment_reference", "source_ongoing_access_reference", "authorized_scope_digest", "target_references", "permitted_action_classes", "prohibited_action_classes", "effective_at", "expires_at", "implementation_authority_digest", "state", "record_version", "created_at", "updated_at"],
  "properties": {
    "implementation_authorization_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/implementationAuthorizationId"}, "authorization_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/positiveVersion"}, "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"}, "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "implementation_brief_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationBriefReference"}, "implementation_brief_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"}, "source_conversion_decision_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/conversionDecisionReference"}, "source_ongoing_agreement_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/ongoingAgreementReference"}, "source_ongoing_payment_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/ongoingPaymentReference"}, "source_ongoing_access_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/ongoingAccessReference"},
    "authorized_scope_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"}, "target_references": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/targetReferences"}, "permitted_action_classes": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/permittedBuildActions"}, "prohibited_action_classes": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/requiredProhibitedActions"}, "effective_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "expires_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "implementation_authority_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/digest"}, "state": {"type": "string", "enum": ["PROPOSED", "ACTIVE", "EXPIRED", "REVOKED", "SUPERSEDED"]}, "client_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/humanApprovalReference"}, "sekinfra_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/humanApprovalReference"}, "activated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "revoked_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "revocation_reason": {"type": "string", "enum": ["CLIENT_WITHDRAWAL", "SEKINFRA_WITHDRAWAL", "SCOPE_CHANGED", "COMMERCIAL_AUTHORITY_INVALID", "ONGOING_ACCESS_INVALID", "SECURITY_CONCERN"]}, "supersedes_implementation_authorization_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationAuthorizationReference"}, "record_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/positiveVersion"}, "created_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}, "updated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}
  },
  "allOf": [{"if": {"properties": {"state": {"enum": ["ACTIVE", "EXPIRED", "SUPERSEDED"]}}, "required": ["state"]}, "then": {"required": ["client_approval_reference", "sekinfra_approval_reference", "activated_at"]}}, {"if": {"properties": {"state": {"const": "REVOKED"}}, "required": ["state"]}, "then": {"required": ["revoked_at", "revocation_reason"]}}, {"if": {"properties": {"authorization_version": {"minimum": 2}}, "required": ["authorization_version"]}, "then": {"required": ["supersedes_implementation_authorization_reference"]}}]
}
