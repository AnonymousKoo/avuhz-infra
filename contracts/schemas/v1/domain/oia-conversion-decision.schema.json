{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:oia-conversion-decision:v1",
  "title": "OIAConversionDecision v1",
  "description": "Authoritative client conversion decision anchored to one exact immutable OIA Findings Delivery. It creates no agreement, payment, access, implementation, or deployment authority.",
  "type": "object", "additionalProperties": false,
  "required": ["oia_conversion_decision_id", "decision_version", "tenant_id", "engagement_id", "oia_assessment_id", "oia_findings_delivery_id", "delivery_sequence", "delivery_manifest_digest", "decision", "state", "selected_finding_revisions", "conversion_authority_digest", "client_approval_reference", "decided_at", "record_version", "created_at", "updated_at"],
  "properties": {
    "oia_conversion_decision_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaConversionDecisionId"},
    "decision_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "oia_assessment_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaAssessmentId"},
    "oia_findings_delivery_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaFindingsDeliveryId"},
    "delivery_sequence": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "delivery_manifest_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/digest"},
    "decision": {"type": "string", "enum": ["PROCEED", "DECLINE"]},
    "state": {"type": "string", "enum": ["PENDING_SEKINFRA", "ACCEPTED", "DECLINED"]},
    "selected_finding_revisions": {"type": "array", "minItems": 0, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/findingRevisionReference"}},
    "conversion_authority_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/digest"},
    "client_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/humanApprovalReference"},
    "sekinfra_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/humanApprovalReference"},
    "supersedes_decision_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/conversionDecisionReference"},
    "decided_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "accepted_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "record_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "created_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "updated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "PROCEED"}}, "required": ["decision"]}, "then": {"properties": {"selected_finding_revisions": {"minItems": 1}, "state": {"enum": ["PENDING_SEKINFRA", "ACCEPTED"]}}}},
    {"if": {"properties": {"decision": {"const": "DECLINE"}}, "required": ["decision"]}, "then": {"properties": {"state": {"const": "DECLINED"}, "selected_finding_revisions": {"maxItems": 0}}, "not": {"anyOf": [{"required": ["sekinfra_approval_reference"]}, {"required": ["accepted_at"]}]}}},
    {"if": {"properties": {"state": {"const": "ACCEPTED"}}, "required": ["state"]}, "then": {"required": ["sekinfra_approval_reference", "accepted_at"]}}
  ]
}
