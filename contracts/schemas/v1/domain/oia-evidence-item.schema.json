{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:avuhz:schema:contracts:domain:oia-evidence-item:v1","title":"OIAEvidenceItem v1","description":"Immutable provenance metadata for one bounded evidence artifact. Secure-object references are opaque; no blobs, credentials, provider payloads, or arbitrary metadata are retained.","type":"object","additionalProperties":false,"required":["tenant_id","oia_evidence_id","oia_assessment_id","source_system_reference","evidence_type","captured_at","captured_by","scope_action","secure_object_reference","content_digest","sensitivity","retention_status","created_at"],"properties":{"tenant_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},"oia_evidence_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaEvidenceId"},"oia_assessment_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaAssessmentId"},"source_system_reference":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},"evidence_type":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/evidenceType"},"captured_at":{"$ref":"urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},"captured_by":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/trustedActorReference"},"scope_action":{"type":"string","enum":["VIEW_CONFIGURATION","VIEW_OPERATIONAL_STATE","VIEW_LOGS","VIEW_METRICS","VIEW_ACCESS_CONFIGURATION","VIEW_NETWORK_CONFIGURATION","VIEW_SECURITY_CONFIGURATION","VIEW_COMPLIANCE_EVIDENCE","NON_DESTRUCTIVE_CONNECTIVITY_TEST","NON_DESTRUCTIVE_PERMISSION_TEST"]},"secure_object_reference":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},"content_digest":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/digest"},"sensitivity":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/evidenceSensitivity"},"retention_status":{"$ref":"urn:avuhz:schema:contracts:domain:oia-c