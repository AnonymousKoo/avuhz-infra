{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:avuhz:schema:contracts:domain:oia-observation:v1","title":"OIAObservation v1","description":"First-class internal analytical observation supported by evidence; it is not automatically client-facing and contains no recommendation.","type":"object","additionalProperties":false,"required":["tenant_id","oia_observation_id","oia_assessment_id","evidence_ids","system_process_area","observed_condition","confidence","state","record_version","created_by","created_at","updated_at"],"properties":{"tenant_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},"oia_observation_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaObservationId"},"oia_assessment_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaAssessmentId"},"evidence_ids":{"type":"array","minItems":1,"maxItems":50,"uniqueItems":true,"items":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaEvidenceId"}},"system_process_area":{"type":"string","minLength":1,"maxLength":160},"observed_condition":{"type":"string","minLength":1,"maxLength":4000},"expected_condition":{"type":"string","minLength":1,"maxLength":4000},"confidence":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/confidence"},"state":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/observationState"},"superseded_by_observation_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/oiaObservationId"},"record_version":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/positiveVersion"},"created_by":{"$ref":"urn:avuhz:schema:contracts:domain:oia-common:v1#/$defs/trustedActorReference"},"created_at":{"$ref":"urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},"updated_at":{"$ref":"urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}},"allOf":[{"if":{"properties":{"state":{"const":"SUPERSEDED"}},"required":["state"]},"then":{"required":["superseded_by_observation_id"]}}]}
