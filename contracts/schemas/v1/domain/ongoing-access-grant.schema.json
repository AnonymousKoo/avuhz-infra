{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:ongoing-access-grant:v1",
  "title": "OngoingAccessGrant v1",
  "description": "A new bounded ongoing access-channel authority, never an extension or conversion of AssessmentAccessGrant. ACTIVE means a channel may be used after server-side eligibility revalidation; it never authorizes implementation, change, deployment, or managed operations.",
  "type": "object", "additionalProperties": false,
  "required": ["ongoing_access_grant_id", "tenant_id", "engagement_id", "conversion_decision_reference", "ongoing_agreement_reference", "ongoing_payment_verification_reference", "service_scope_digest", "ongoing_access_authority_digest", "target_resource_references", "access_channel_reference", "access_purpose", "state", "proposed_at", "effective_at", "review_at", "expires_at", "record_version"],
  "properties": {
    "ongoing_access_grant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAccessGrantId"},
    "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "conversion_decision_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/conversionDecisionReference"},
    "ongoing_agreement_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingAgreementReference"},
    "ongoing_payment_verification_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingPaymentReference"},
    "service_scope_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/digest"},
    "ongoing_access_authority_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/digest"},
    "target_resource_references": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/targetResourceReference"}},
    "access_channel_reference": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "access_purpose": {"type": "string", "const": "ONGOING_SERVICE_CHANNEL"},
    "state": {"type": "string", "enum": ["PROPOSED", "APPROVED", "ACTIVE", "EXPIRED", "REVOKED", "CLOSED"]},
    "client_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/humanApprovalReference"},
    "sekinfra_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/humanApprovalReference"},
    "proposed_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "approved_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "verified_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "active_from": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "effective_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "review_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "expires_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "revoked_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "revocation_reason": {"type": "string", "enum": ["MANUAL_AUTHORIZED_REVOCATION", "EMERGENCY_SECURITY_REVOCATION"]},
    "closed_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "closure_reason": {"type": "string", "enum": ["AGREEMENT_ENDED", "COMMERCIAL_AUTHORITY_INVALID", "OFFBOARDING_COMPLETED", "ENGAGEMENT_COMPLETED"]},
    "record_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["APPROVED", "ACTIVE", "EXPIRED", "REVOKED", "CLOSED"]}}, "required": ["state"]}, "then": {"required": ["client_approval_reference", "sekinfra_approval_reference", "approved_at"]}},
    {"if": {"properties": {"state": {"enum": ["ACTIVE", "EXPIRED"]}}, "required": ["state"]}, "then": {"required": ["verified_at", "active_from"]}},
    {"if": {"properties": {"state": {"const": "REVOKED"}}, "required": ["state"]}, "then": {"required": ["revoked_at", "revocation_reason"]}},
    {"if": {"properties": {"state": {"const": "CLOSED"}}, "required": ["state"]}, "then": {"required": ["closed_at", "closure_reason"]}}
  ]
}
