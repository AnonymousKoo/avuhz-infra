{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:ongoing-access-revocation-verification:v1",
  "title": "OngoingAccessRevocationVerification v1",
  "description": "Immutable trusted verification that external ongoing access was removed or was already absent. A revocation request alone cannot create this record.",
  "type": "object", "additionalProperties": false,
  "required": ["ongoing_access_revocation_verification_id", "tenant_id", "engagement_id", "ongoing_access_grant_reference", "verification_result", "verification_reference", "verified_at", "verified_by", "record_version"],
  "properties": {
    "ongoing_access_revocation_verification_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAccessRevocationVerificationId"},
    "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "ongoing_access_grant_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingAccessGrantReference"},
    "offboarding_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/offboardingReference"},
    "verification_result": {"type": "string", "enum": ["ACCESS_REMOVAL_VERIFIED", "ACCESS_ALREADY_ABSENT"]},
    "verification_reference": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "verified_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "verified_by": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/trustedActorReference"},
    "record_version": {"type": "integer", "const": 1}
  }
}
