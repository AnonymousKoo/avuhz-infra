{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:ongoing-agreement-authority:v1",
  "title": "OngoingAgreementAuthority v1",
  "description": "Versioned Agreement #2 authority for bounded ongoing services. It contains commercial scope, not implementation design, production instructions, credentials, or access authority.",
  "type": "object", "additionalProperties": false,
  "required": ["ongoing_agreement_authority_id", "agreement_version", "tenant_id", "engagement_id", "conversion_decision_reference", "findings_delivery_reference", "agreement_reference", "service_scope", "service_scope_digest", "agreement_authority_digest", "state", "effective_at", "record_version", "created_at", "updated_at"],
  "properties": {
    "ongoing_agreement_authority_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingAgreementAuthorityId"},
    "agreement_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "conversion_decision_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/conversionDecisionReference"},
    "findings_delivery_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/findingsDeliveryReference"},
    "agreement_reference": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "service_scope": {"$ref": "#/$defs/serviceScope"},
    "service_scope_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/digest"},
    "agreement_authority_digest": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/digest"},
    "state": {"type": "string", "enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "ENDED", "TERMINATED", "REVOKED"]},
    "client_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/humanApprovalReference"},
    "sekinfra_approval_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/humanApprovalReference"},
    "supersedes_agreement_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingAgreementReference"},
    "effective_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "ends_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "activated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "terminal_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "terminal_reason": {"type": "string", "enum": ["TERM_ENDED", "ENGAGEMENT_COMPLETED", "CLIENT_TERMINATION", "SEKINFRA_TERMINATION", "AUTHORITY_REVOKED", "SUPERSEDED_BY_NEW_VERSION"]},
    "record_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"},
    "created_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "updated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"}
  },
  "$defs": {
    "serviceScope": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_finding_revisions", "intervention_categories", "service_areas", "target_system_references", "commercial_boundaries", "explicit_exclusions"],
      "properties": {
        "selected_finding_revisions": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/findingRevisionReference"}},
        "intervention_categories": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "enum": ["CONFIGURATION_CHANGE", "PROCESS_CHANGE", "INTEGRATION_CHANGE", "ACCESS_OR_PERMISSION_CHANGE", "OBSERVABILITY_CHANGE", "SECURITY_HARDENING", "FURTHER_INVESTIGATION"]}},
        "service_areas": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"}},
        "target_system_references": {"type": "array", "minItems": 0, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/targetResourceReference"}},
        "commercial_boundaries": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/boundedStatements"},
        "explicit_exclusions": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/boundedStatements"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "ACTIVE"}}, "required": ["state"]}, "then": {"required": ["client_approval_reference", "sekinfra_approval_reference", "activated_at"]}},
    {"if": {"properties": {"state": {"enum": ["SUPERSEDED", "ENDED", "TERMINATED", "REVOKED"]}}, "required": ["state"]}, "then": {"required": ["terminal_at", "terminal_reason"]}}
  ]
}
