{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:domain:ongoing-payment-verification:v1",
  "title": "OngoingPaymentVerification v1",
  "description": "Authoritative provider-neutral verification of one bounded ongoing commercial condition and coverage period. It is not access authority and contains no payment instrument, provider payload, credential, or secret.",
  "type": "object", "additionalProperties": false,
  "required": ["ongoing_payment_verification_id", "tenant_id", "engagement_id", "ongoing_agreement_reference", "verification_basis", "coverage_from", "coverage_until", "verification_reference", "status", "verified_at", "verified_by", "record_version"],
  "properties": {
    "ongoing_payment_verification_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/ongoingPaymentVerificationId"},
    "tenant_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "ongoing_agreement_reference": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/ongoingAgreementReference"},
    "verification_basis": {"type": "string", "enum": ["PAYMENT", "RETAINER", "APPROVED_COMMERCIAL_COVERAGE"]},
    "amount_minor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "coverage_from": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "coverage_until": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "verification_reference": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "status": {"type": "string", "enum": ["VERIFIED", "INVALIDATED"]},
    "verified_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "verified_by": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/trustedActorReference"},
    "invalidated_at": {"$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "invalidation_reason": {"type": "string", "enum": ["PAYMENT_REVERSED", "COVERAGE_ENDED", "VERIFICATION_REVOKED", "AGREEMENT_TERMINATED"]},
    "record_version": {"$ref": "urn:avuhz:schema:contracts:domain:phase5c-common:v1#/$defs/positiveVersion"}
  },
  "allOf": [
    {"if": {"properties": {"verification_basis": {"enum": ["PAYMENT", "RETAINER"]}}, "required": ["verification_basis"]}, "then": {"required": ["amount_minor", "currency"]}},
    {"if": {"properties": {"status": {"const": "INVALIDATED"}}, "required": ["status"]}, "then": {"required": ["invalidated_at", "invalidation_reason"]}, "else": {"not": {"anyOf": [{"required": ["invalidated_at"]}, {"required": ["invalidation_reason"]}]}}}
  ]
}
