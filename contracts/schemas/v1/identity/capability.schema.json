{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:identity:capability:v1",
  "title": "Avuhz Governed Capability v1",
  "description": "Closed provider-neutral vocabulary for bounded foundation, shared-system, and implementation-governance actions. Capabilities do not establish tenant membership or human authority.",
  "type": "string",
  "minLength": 8,
  "maxLength": 42,
  "enum": [
    "engagement:read",
    "engagement:accept_handoff",
    "engagement:open",
    "implementation_handoff:accept",
    "inbound_event:record",
    "event:publish_internal",
    "implementation_brief:draft",
    "implementation_brief:approve",
    "implementation_authorization:propose",
    "implementation_authorization:approve",
    "implementation_authorization:activate",
    "implementation_authorization:revoke",
    "codex_build_package:draft",
    "codex_build_package:approve",
    "codex_build_package:release",
    "build_execution:start",
    "build_execution:complete",
    "qa_result:record",
    "client_acceptance:record",
    "deployment_authorization:propose",
    "deployment_authorization:approve",
    "deployment_authorization:activate",
    "deployment_authorization:revoke"
  ]
}
