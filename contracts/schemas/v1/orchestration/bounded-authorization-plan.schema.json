{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:orchestration:bounded-authorization-plan:v1",
  "title": "Bounded Provider Change Authorization Plan v1",
  "description": "Immutable provider-neutral definition of an ordered, evidence-gated change plan. The plan grants no authority without a separate exact owner approval and never batches resource mutations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "plan_version",
    "plan_digest",
    "definition_status",
    "environment",
    "target",
    "owner_identity",
    "created_at",
    "authorization_window",
    "ordered_step_ids",
    "steps",
    "prohibited_actions",
    "stop_conditions",
    "authority_effect"
  ],
  "properties": {
    "plan_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "definition_status": {
      "enum": [
        "DRAFT_BLOCKED",
        "READY_FOR_APPROVAL"
      ]
    },
    "environment": {
      "$ref": "urn:avuhz:schema:contracts:common:environment:v1#/$defs/environment"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "owner_identity": {
      "$ref": "#/$defs/boundedText"
    },
    "created_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "authorization_window": {
      "$ref": "#/$defs/authorizationWindow"
    },
    "ordered_step_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "prohibited_actions": {
      "$ref": "#/$defs/referenceList"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "authority_effect": {
      "const": "NONE_UNTIL_SEPARATELY_APPROVED"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,159}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "referenceList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "bindingDigestPolicy": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "PROHIBITED"
      ]
    },
    "bindingPersistencePolicy": {
      "enum": [
        "SANITIZED_VALUE_ALLOWED",
        "DIGEST_ONLY",
        "PROHIBITED"
      ]
    },
    "preapprovalValue": {
      "description": "Exact immutable non-secret value or reference fixed before approval. The exact_digest is part of the plan definition; the authorization engine separately verifies that it is the canonical digest of value and matches the declaration value class.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "exact_digest"
      ],
      "properties": {
        "value": {
          "description": "Bounded non-secret scalar constrained by the containing binding declaration's value_class.",
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "exact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "bindingDeclaration": {
      "description": "Provider-neutral declaration of when a binding becomes authoritative and how its provenance may be recorded. Runtime values are never carried here; an optional exact digest-bound preapproval_value may carry only a bounded non-secret value fixed before approval. Cross-step ordering, digest equality, and evidence integrity are enforced by the authorization engine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "phase",
        "value_class",
        "source_step_id",
        "evidence_type",
        "digest_policy",
        "persistence_policy"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/reference"
        },
        "phase": {
          "enum": [
            "PREAPPROVAL_BOUND",
            "DERIVED_FROM_SOURCE_STEP",
            "PRODUCED_BY_CURRENT_STEP",
            "RESOLVED_BY_STEP_PREFLIGHT",
            "EPHEMERAL_HANDOFF",
            "UNRESOLVED_BLOCKER"
          ]
        },
        "value_class": {
          "enum": [
            "STABLE_REFERENCE",
            "UUID_IDENTIFIER",
            "CONTENT_DIGEST",
            "PROCEDURE_REFERENCE",
            "CONFIGURATION_REFERENCE",
            "EPHEMERAL_SENSITIVE"
          ]
        },
        "source_step_id": {
          "$ref": "#/$defs/nullableReference"
        },
        "evidence_type": {
          "$ref": "#/$defs/nullableReference"
        },
        "digest_policy": {
          "$ref": "#/$defs/bindingDigestPolicy"
        },
        "persistence_policy": {
          "$ref": "#/$defs/bindingPersistencePolicy"
        },
        "preapproval_value": {
          "$ref": "#/$defs/preapprovalValue"
        }
      },
      "dependentSchemas": {
        "preapproval_value": {
          "properties": {
            "phase": {
              "const": "PREAPPROVAL_BOUND"
            },
            "value_class": {
              "enum": [
                "STABLE_REFERENCE",
                "UUID_IDENTIFIER",
                "CONTENT_DIGEST",
                "PROCEDURE_REFERENCE",
                "CONFIGURATION_REFERENCE"
              ]
            },
            "digest_policy": {
              "const": "REQUIRED"
            }
          },
          "required": [
            "phase",
            "value_class",
            "digest_policy"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_class": {
                "const": "UUID_IDENTIFIER"
              }
            },
            "required": [
              "value_class",
              "preapproval_value"
            ]
          },
          "then": {
            "properties": {
              "preapproval_value": {
                "properties": {
                  "value": {
                    "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_class": {
                "enum": [
                  "STABLE_REFERENCE",
                  "PROCEDURE_REFERENCE",
                  "CONFIGURATION_REFERENCE"
                ]
              }
            },
            "required": [
              "value_class",
              "preapproval_value"
            ]
          },
          "then": {
            "properties": {
              "preapproval_value": {
                "properties": {
                  "value": {
                    "$ref": "#/$defs/reference"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_class": {
                "const": "CONTENT_DIGEST"
              }
            },
            "required": [
              "value_class",
              "preapproval_value"
            ]
          },
          "then": {
            "properties": {
              "preapproval_value": {
                "properties": {
                  "value": {
                    "$ref": "#/$defs/digest"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "PREAPPROVAL_BOUND"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "value_class": {
                "not": {
                  "const": "EPHEMERAL_SENSITIVE"
                }
              },
              "source_step_id": {
                "type": "null"
              },
              "evidence_type": {
                "type": "null"
              },
              "digest_policy": {
                "enum": [
                  "REQUIRED",
                  "OPTIONAL"
                ]
              },
              "persistence_policy": {
                "enum": [
                  "SANITIZED_VALUE_ALLOWED",
                  "DIGEST_ONLY"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "DERIVED_FROM_SOURCE_STEP"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "value_class": {
                "not": {
                  "const": "EPHEMERAL_SENSITIVE"
                }
              },
              "source_step_id": {
                "$ref": "#/$defs/reference"
              },
              "evidence_type": {
                "$ref": "#/$defs/reference"
              },
              "digest_policy": {
                "const": "REQUIRED"
              },
              "persistence_policy": {
                "enum": [
                  "SANITIZED_VALUE_ALLOWED",
                  "DIGEST_ONLY"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "PRODUCED_BY_CURRENT_STEP"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "value_class": {
                "not": {
                  "const": "EPHEMERAL_SENSITIVE"
                }
              },
              "source_step_id": {
                "type": "null"
              },
              "evidence_type": {
                "$ref": "#/$defs/reference"
              },
              "digest_policy": {
                "const": "REQUIRED"
              },
              "persistence_policy": {
                "enum": [
                  "SANITIZED_VALUE_ALLOWED",
                  "DIGEST_ONLY"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "RESOLVED_BY_STEP_PREFLIGHT"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "value_class": {
                "not": {
                  "const": "EPHEMERAL_SENSITIVE"
                }
              },
              "source_step_id": {
                "type": "null"
              },
              "evidence_type": {
                "$ref": "#/$defs/reference"
              },
              "digest_policy": {
                "const": "REQUIRED"
              },
              "persistence_policy": {
                "enum": [
                  "SANITIZED_VALUE_ALLOWED",
                  "DIGEST_ONLY"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "EPHEMERAL_HANDOFF"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "value_class": {
                "const": "EPHEMERAL_SENSITIVE"
              },
              "source_step_id": {
                "$ref": "#/$defs/reference"
              },
              "evidence_type": {
                "$ref": "#/$defs/reference"
              },
              "digest_policy": {
                "const": "PROHIBITED"
              },
              "persistence_policy": {
                "const": "PROHIBITED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "UNRESOLVED_BLOCKER"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "source_step_id": {
                "type": "null"
              },
              "evidence_type": {
                "type": "null"
              },
              "digest_policy": {
                "const": "PROHIBITED"
              },
              "persistence_policy": {
                "const": "PROHIBITED"
              }
            }
          }
        }
      ]
    },
    "producedEvidenceDeclaration": {
      "description": "Provider-neutral declaration of evidence a step may produce and the binding identifiers that evidence may establish. Evidence payload shape and cross-step provenance are enforced separately.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "established_binding_ids",
        "digest_policy"
      ],
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/reference"
        },
        "established_binding_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "digest_policy": {
          "enum": [
            "REQUIRED",
            "OPTIONAL"
          ]
        }
      }
    },
    "authorizationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_state",
        "starts_at",
        "expires_at"
      ],
      "properties": {
        "binding_state": {
          "enum": [
            "BOUND",
            "UNRESOLVED_BLOCKER"
          ]
        },
        "starts_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_class",
        "provider_reference",
        "project_reference",
        "responsibility",
        "issuer_reference",
        "audience_reference"
      ],
      "properties": {
        "provider_class": {
          "$ref": "#/$defs/reference"
        },
        "provider_reference": {
          "$ref": "#/$defs/reference"
        },
        "project_reference": {
          "$ref": "#/$defs/reference"
        },
        "responsibility": {
          "enum": [
            "AUTH",
            "DATA",
            "RUNTIME",
            "WORKER",
            "OBSERVABILITY",
            "PLATFORM"
          ]
        },
        "issuer_reference": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^@]+$",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "audience_reference": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_reference",
        "binding_state",
        "exact_version",
        "exact_digest"
      ],
      "properties": {
        "resource_type": {
          "$ref": "#/$defs/reference"
        },
        "resource_reference": {
          "$ref": "#/$defs/boundedText"
        },
        "binding_state": {
          "enum": [
            "BOUND",
            "UNRESOLVED_BLOCKER"
          ]
        },
        "exact_version": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "credentialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "allowed_classes",
        "values_stored"
      ],
      "properties": {
        "permitted": {
          "type": "boolean"
        },
        "allowed_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NONE",
              "OWNER_INTERACTIVE_SESSION",
              "MIGRATION_IDENTITY",
              "SYNTHETIC_IDENTITY",
              "EPHEMERAL_SYNTHETIC_ACCESS_TOKEN"
            ]
          }
        },
        "values_stored": {
          "const": false
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "source_step_id",
        "binding_state",
        "exact_digest"
      ],
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/reference"
        },
        "source_step_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_state": {
          "enum": [
            "BOUND",
            "DERIVED_FROM_SOURCE_STEP",
            "UNRESOLVED_BLOCKER"
          ]
        },
        "exact_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "ordinal",
        "resource",
        "operation",
        "dependency_step_ids",
        "required_evidence",
        "expected_postcondition",
        "prohibited_actions",
        "stop_conditions",
        "correction_reference",
        "execution_class",
        "credential_policy",
        "unresolved_bindings"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/reference"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "operation": {
          "$ref": "#/$defs/reference"
        },
        "dependency_step_ids": {
          "type": "array",
          "maxItems": 31,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "expected_postcondition": {
          "$ref": "#/$defs/boundedText"
        },
        "prohibited_actions": {
          "$ref": "#/$defs/referenceList"
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "correction_reference": {
          "oneOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_class": {
          "enum": [
            "LOCAL_ONLY",
            "PROVIDER_READ",
            "PROVIDER_MUTATION"
          ]
        },
        "credential_policy": {
          "$ref": "#/$defs/credentialPolicy"
        },
        "binding_declarations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/bindingDeclaration"
          }
        },
        "produced_evidence": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/producedEvidenceDeclaration"
          }
        },
        "unresolved_bindings": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  }
}
