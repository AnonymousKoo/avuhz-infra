{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:orchestration:engineering-dry-run-evidence:v1",
  "title": "Avuhz Local Engineering Dry-Run Evidence v1",
  "description": "Bounded local build/test/security evidence and simulated readiness truth. It grants no human, deployment, production, or infrastructure authority and contains no command output, environment values, provider payloads, credentials, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "schema_version",
    "source",
    "provenance",
    "artifact",
    "steps",
    "review_gate",
    "simulated_approval",
    "readiness_decision",
    "created_at",
    "expires_at",
    "bundle_digest"
  ],
  "properties": {
    "evidence_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "review_gate": {
      "$ref": "#/$defs/reviewGate"
    },
    "simulated_approval": {
      "$ref": "#/$defs/simulatedApproval"
    },
    "readiness_decision": {
      "$ref": "#/$defs/readinessDecision"
    },
    "created_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_reference",
        "git_commit",
        "git_branch",
        "source_digest",
        "working_tree_clean"
      ],
      "properties": {
        "repository_reference": {
          "const": "repository.avuhz-infra"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "git_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "working_tree_clean": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_reference",
        "pipeline_version",
        "python_version",
        "operating_system",
        "command_catalog_digest",
        "source_date_epoch"
      ],
      "properties": {
        "pipeline_reference": {
          "const": "engineering.dry-run-local"
        },
        "pipeline_version": {
          "const": 1
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "operating_system": {
          "enum": [
            "linux",
            "darwin",
            "windows"
          ]
        },
        "command_catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_date_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_filename",
        "package_name",
        "package_version",
        "artifact_digest",
        "size_bytes",
        "service_module_included",
        "worker_module_included",
        "dependency_inventory"
      ],
      "properties": {
        "artifact_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}\\.whl$"
        },
        "package_name": {
          "const": "avuhz-service"
        },
        "package_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "service_module_included": {
          "const": true
        },
        "worker_module_included": {
          "const": true
        },
        "dependency_inventory": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\[\\],<>=!-]{2,127}$"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "status",
        "command_references",
        "started_at",
        "completed_at",
        "result_digest",
        "skipped_checks",
        "check_count",
        "passed_count",
        "failed_count"
      ],
      "properties": {
        "step_id": {
          "enum": [
            "BUILD",
            "TESTS",
            "CONTRACTS",
            "MIGRATIONS",
            "SECURITY",
            "PACKAGE_VERIFICATION"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "command_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
          }
        },
        "started_at": {
          "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
        },
        "completed_at": {
          "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
        },
        "result_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "skipped_checks": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
          }
        },
        "check_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "reviewGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required_step_digests",
        "authority_effect"
      ],
      "properties": {
        "status": {
          "enum": [
            "READY_FOR_SIMULATED_REVIEW",
            "BLOCKED"
          ]
        },
        "required_step_digests": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "authority_effect": {
          "const": "NONE"
        }
      }
    },
    "simulatedApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_decision",
        "status",
        "reviewer_reference",
        "authority_effect",
        "human_authority_established",
        "production_authority_established"
      ],
      "properties": {
        "requested_decision": {
          "enum": [
            "APPROVE",
            "DECLINE",
            "NOT_RECORDED"
          ]
        },
        "status": {
          "enum": [
            "SIMULATED_APPROVAL_RECORDED",
            "SIMULATED_DECLINE_RECORDED",
            "NOT_RECORDED",
            "BLOCKED_BY_EVIDENCE"
          ]
        },
        "reviewer_reference": {
          "oneOf": [
            {
              "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_effect": {
          "const": "NONE"
        },
        "human_authority_established": {
          "const": false
        },
        "production_authority_established": {
          "const": false
        }
      }
    },
    "readinessDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "environment_class",
        "production_ready",
        "deployment_authorized",
        "production_mutation_performed",
        "missing_requirements"
      ],
      "properties": {
        "status": {
          "enum": [
            "SIMULATION_READY",
            "BLOCKED"
          ]
        },
        "environment_class": {
          "const": "LOCAL"
        },
        "production_ready": {
          "const": false
        },
        "deployment_authorized": {
          "const": false
        },
        "production_mutation_performed": {
          "const": false
        },
        "missing_requirements": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
          }
        }
      }
    }
  }
}
