{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:orchestration:lifecycle-event:v1",
  "title": "Avuhz Lifecycle Event v1",
  "description": "Append-only sanitized event for an accepted provider-neutral transition. Events are non-authoritative and contain no raw domain payloads, credentials, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_schema_version",
    "tenant_id",
    "authoritative_subject_reference",
    "authoritative_subject_version",
    "occurred_at",
    "producer_reference",
    "correlation_id",
    "idempotency_key",
    "visibility",
    "sanitized_metadata"
  ],
  "properties": {
    "event_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/eventId"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "engagement.handoff.accepted",
        "engagement.opened",
        "implementation_brief.drafted",
        "implementation_brief.revised",
        "implementation_brief.approval_recorded",
        "implementation_brief.approved",
        "implementation_authorization.proposed",
        "implementation_authorization.revised",
        "implementation_authorization.approval_recorded",
        "implementation_authorization.activated",
        "implementation_authorization.revoked",
        "codex_build_package.drafted",
        "codex_build_package.revised",
        "codex_build_package.approval_recorded",
        "codex_build_package.released",
        "build_execution.started",
        "build_execution.completed",
        "qa_result.recorded",
        "client_acceptance.recorded",
        "deployment_authorization.proposed",
        "deployment_authorization.revised",
        "deployment_authorization.approval_recorded",
        "deployment_authorization.activated",
        "deployment_authorization.revoked"
      ]
    },
    "event_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "authoritative_subject_reference": {
      "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"
    },
    "authoritative_subject_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "producer_reference": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
    },
    "command_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/commandId"
    },
    "subject_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "correlation_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/correlationId"
    },
    "causation_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/causationId"
    },
    "idempotency_key": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "TENANT_OPERATIONAL",
        "INTEGRATION_INTERNAL"
      ]
    },
    "sanitized_metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "handoffMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id"
      ],
      "properties": {
        "handoff_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/handoffId"
        }
      }
    },
    "engagementMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engagement_id"
      ],
      "properties": {
        "engagement_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
        }
      }
    },
    "governanceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_stage"
      ],
      "properties": {
        "authority_stage": {
          "type": "string",
          "enum": [
            "IMPLEMENTATION_BRIEF",
            "IMPLEMENTATION_AUTHORIZATION",
            "CODEX_BUILD_PACKAGE",
            "BUILD_EXECUTION",
            "QA_RESULT",
            "CLIENT_ACCEPTANCE",
            "DEPLOYMENT_AUTHORIZATION"
          ]
        },
        "state": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "maxLength": 40
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "BLOCKED"
          ]
        },
        "approval_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/approvalId"
        },
        "implementation_brief_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/implementationBriefId"
        },
        "implementation_authorization_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/implementationAuthorizationId"
        },
        "codex_build_package_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/codexBuildPackageId"
        },
        "build_execution_result_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/buildExecutionResultId"
        },
        "qa_result_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/qaResultId"
        },
        "client_acceptance_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/clientAcceptanceId"
        },
        "deployment_authorization_id": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/deploymentAuthorizationId"
        },
        "superseded_version": {
          "type": "integer",
          "minimum": 1
        },
        "execution_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "qa_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "qa_passed": {
          "type": "boolean"
        },
        "client_accepted": {
          "type": "boolean"
        },
        "deployment_authorized": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "engagement.handoff.accepted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "ACQUISITION_HANDOFF"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/handoffMetadata"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "engagement.opened"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "ENGAGEMENT"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/engagementMetadata"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "implementation_brief.drafted",
              "implementation_brief.revised",
              "implementation_brief.approval_recorded",
              "implementation_brief.approved"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "IMPLEMENTATION_BRIEF"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "implementation_brief_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "implementation_authorization.proposed",
              "implementation_authorization.revised",
              "implementation_authorization.approval_recorded",
              "implementation_authorization.activated",
              "implementation_authorization.revoked"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "IMPLEMENTATION_AUTHORIZATION"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "implementation_authorization_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "codex_build_package.drafted",
              "codex_build_package.revised",
              "codex_build_package.approval_recorded",
              "codex_build_package.released"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "CODEX_BUILD_PACKAGE"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "codex_build_package_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "build_execution.started",
              "build_execution.completed"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "BUILD_EXECUTION_RESULT"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "build_execution_result_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "qa_result.recorded"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "QA_RESULT"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "qa_result_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "client_acceptance.recorded"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "CLIENT_ACCEPTANCE"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "client_acceptance_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "deployment_authorization.proposed",
              "deployment_authorization.revised",
              "deployment_authorization.approval_recorded",
              "deployment_authorization.activated",
              "deployment_authorization.revoked"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "engagement_id"
        ],
        "properties": {
          "authoritative_subject_reference": {
            "properties": {
              "reference_type": {
                "const": "DEPLOYMENT_AUTHORIZATION"
              }
            }
          },
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "deployment_authorization_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "implementation_brief.revised",
              "implementation_authorization.revised",
              "codex_build_package.revised",
              "deployment_authorization.revised"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "sanitized_metadata": {
            "$ref": "#/$defs/governanceMetadata",
            "required": [
              "authority_stage",
              "superseded_version"
            ]
          }
        }
      }
    }
  ]
}
