{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:orchestration:lifecycle-event:v1",
  "title": "Avuhz Slice 1 Lifecycle Event v1",
  "description": "Append-only sanitized orchestration output describing an already accepted authoritative transition. It is not authoritative state and cannot contain a full domain snapshot, approval body, raw provider payload, credentials, stack trace, or arbitrary metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_schema_version", "tenant_id", "authoritative_subject_reference", "authoritative_subject_version", "occurred_at", "producer_reference", "correlation_id", "idempotency_key", "visibility", "sanitized_metadata"],
  "properties": {
    "event_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/eventId"},
    "event_type": {"type": "string", "enum": ["engagement.handoff.accepted", "engagement.opened", "diagnostic_scope.submitted", "diagnostic_scope.approved", "diagnostic_scope.rejected", "human_approval.recorded", "diagnostic_scope.canonicalized", "assessment_access.proposal_created"]},
    "event_schema_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "tenant_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},
    "engagement_id": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},
    "authoritative_subject_reference": {"$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"},
    "authoritative_subject_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "occurred_at": {"readOnly": true, "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"},
    "producer_reference": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"},
    "correlation_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/correlationId"},
    "causation_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/causationId"},
    "idempotency_key": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"},
    "visibility": {"type": "string", "enum": ["TENANT_OPERATIONAL", "SEKINFRA_INTERNAL", "INTEGRATION_INTERNAL"]},
    "sanitized_metadata": {"type": "object"}
  },
  "$defs": {
    "proposalMetadata": {"type": "object", "additionalProperties": false, "required": ["assessment_access_proposal_id"], "properties": {"assessment_access_proposal_id": {"$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/assessmentAccessProposalId"}}},
    "handoffMetadata": {"type": "object", "additionalProperties": false, "required": ["handoff_version"], "properties": {"handoff_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "engagementMetadata": {"type": "object", "additionalProperties": false, "required": ["engagement_state", "engagement_version"], "properties": {"engagement_state": {"const": "OPEN"}, "engagement_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "scopeMetadata": {"type": "object", "additionalProperties": false, "required": ["scope_version"], "properties": {"scope_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}}}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "engagement.handoff.accepted"}}, "required": ["event_type"]}, "then": {"properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "ACQUISITION_HANDOFF"}}}, "sanitized_metadata": {"$ref": "#/$defs/handoffMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "engagement.opened"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "ENGAGEMENT"}}}, "sanitized_metadata": {"$ref": "#/$defs/engagementMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "diagnostic_scope.submitted"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}, "sanitized_metadata": {"$ref": "#/$defs/scopeMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "diagnostic_scope.approved"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}, "sanitized_metadata": {"$ref": "#/$defs/scopeMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "diagnostic_scope.rejected"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}, "sanitized_metadata": {"$ref": "#/$defs/scopeMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "human_approval.recorded"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}, "sanitized_metadata": {"$ref": "#/$defs/scopeMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "diagnostic_scope.canonicalized"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "DIAGNOSTIC_SCOPE"}}}, "sanitized_metadata": {"$ref": "#/$defs/scopeMetadata"}}}},
    {"if": {"properties": {"event_type": {"const": "assessment_access.proposal_created"}}, "required": ["event_type"]}, "then": {"required": ["engagement_id"], "properties": {"authoritative_subject_reference": {"properties": {"reference_type": {"const": "ASSESSMENT_ACCESS_PROPOSAL"}}}, "sanitized_metadata": {"$ref": "#/$defs/proposalMetadata"}}}}
  ]
}
