{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:orchestration:outbox-delivery:v1",
  "title": "Avuhz Slice 1 Outbox Delivery v1",
  "description": "Mutable bounded delivery-tracking record for one immutable LifecycleEvent. It records lease, retry, terminal, and sanitized attempt provenance only; it never stores destination responses, provider payloads, credentials, stack traces, or arbitrary metadata and creates no domain truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outbox_delivery_id",
    "event_reference",
    "destination_reference",
    "status",
    "attempt_count",
    "attempt_history",
    "last_safe_error_code",
    "delivery_idempotency_key",
    "record_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "outbox_delivery_id": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "event_reference": {
      "allOf": [
        {
          "$ref": "urn:avuhz:schema:contracts:common:references:v1#/$defs/internalReference"
        },
        {
          "properties": {
            "reference_type": {
              "const": "LIFECYCLE_EVENT"
            }
          }
        }
      ]
    },
    "destination_reference": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PUBLISHING",
        "PUBLISHED",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "next_attempt_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "published_at": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "last_safe_error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "OUTBOX_COMMIT_FAILED",
        "COMMAND_REJECTED",
        "SECURITY_BLOCKED",
        "DELIVERY_UNAVAILABLE",
        "DELIVERY_REJECTED",
        "LEASE_EXPIRED",
        "EVENT_UNAVAILABLE"
      ]
    },
    "delivery_idempotency_key": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/idempotencyKey"
    },
    "created_at": {
      "readOnly": true,
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "updated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "lease_owner_reference": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
    },
    "lease_token": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/canonicalUuid"
    },
    "lease_expires_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    },
    "attempt_history": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/deliveryAttempt"
      }
    },
    "record_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "last_attempt_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PUBLISHING"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "lease_owner_reference",
          "lease_token",
          "lease_expires_at"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "next_attempt_at"
              ]
            },
            {
              "required": [
                "published_at"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PUBLISHED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "published_at"
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "next_attempt_at"
              ]
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lease_owner_reference"
                  ]
                },
                {
                  "required": [
                    "lease_token"
                  ]
                },
                {
                  "required": [
                    "lease_expires_at"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED_RETRYABLE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "next_attempt_at"
        ],
        "allOf": [
          {
            "not": {
              "required": [
                "published_at"
              ]
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lease_owner_reference"
                  ]
                },
                {
                  "required": [
                    "lease_token"
                  ]
                },
                {
                  "required": [
                    "lease_expires_at"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED_TERMINAL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "next_attempt_at"
                  ]
                },
                {
                  "required": [
                    "published_at"
                  ]
                }
              ]
            }
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lease_owner_reference"
                  ]
                },
                {
                  "required": [
                    "lease_token"
                  ]
                },
                {
                  "required": [
                    "lease_expires_at"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "deliveryAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "worker_reference",
        "started_at",
        "completed_at",
        "outcome",
        "safe_error_code"
      ],
      "properties": {
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "worker_reference": {
          "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/opaqueReferenceId"
        },
        "started_at": {
          "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
        },
        "completed_at": {
          "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PUBLISHED",
            "FAILED_RETRYABLE",
            "FAILED_TERMINAL",
            "LEASE_EXPIRED"
          ]
        },
        "safe_error_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "DELIVERY_UNAVAILABLE",
            "DELIVERY_REJECTED",
            "LEASE_EXPIRED",
            "EVENT_UNAVAILABLE"
          ]
        }
      }
    }
  }
}
