{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:read-models:build-execution-status-view:v1",
  "title": "Build Execution Status View v1",
  "description": "Derived exact-attempt build status. It creates no QA, acceptance, or deployment authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_execution_reference",
    "package_reference",
    "implementation_authorization_reference",
    "status",
    "bindings_exact",
    "terminal",
    "build_succeeded",
    "qa_passed",
    "client_accepted",
    "deployment_authorized",
    "reasons",
    "tenant_id",
    "engagement_id",
    "generated_at"
  ],
  "properties": {
    "build_execution_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/buildExecutionReference"
    },
    "package_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/codexBuildPackageReference"
    },
    "implementation_authorization_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/implementationAuthorizationReference"
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "bindings_exact": {
      "type": "boolean"
    },
    "terminal": {
      "type": "boolean"
    },
    "build_succeeded": {
      "type": "boolean"
    },
    "qa_passed": {
      "const": false
    },
    "client_accepted": {
      "const": false
    },
    "deployment_authorized": {
      "const": false
    },
    "reasons": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
      }
    },
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "generated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  }
}
