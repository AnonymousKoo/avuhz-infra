{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:read-models:client-acceptance-status-view:v1",
  "title": "Client Acceptance Status View v1",
  "description": "Derived exact client decision and staleness. Acceptance alone never authorizes deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_acceptance_reference",
    "package_reference",
    "build_execution_reference",
    "qa_result_reference",
    "decision",
    "sources_exact",
    "stale",
    "client_accepted",
    "deployment_authorized",
    "reasons",
    "tenant_id",
    "engagement_id",
    "generated_at"
  ],
  "properties": {
    "client_acceptance_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/clientAcceptanceReference"
    },
    "package_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/codexBuildPackageReference"
    },
    "build_execution_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/buildExecutionReference"
    },
    "qa_result_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/qaResultReference"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "sources_exact": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    },
    "client_accepted": {
      "type": "boolean"
    },
    "deployment_authorized": {
      "const": false
    },
    "reasons": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
      }
    },
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "generated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  }
}
