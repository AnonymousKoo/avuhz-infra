{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:read-models:codex-build-package-readiness-view:v1",
  "title": "Codex Build Package Readiness View v1",
  "description": "Derived package readiness for bounded implementation execution. Package readiness does not grant implementation, deployment, or production-change authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "engagement_id",
    "codex_build_package_reference",
    "implementation_brief_reference",
    "implementation_authorization_reference",
    "package_state",
    "brief_ready",
    "implementation_authorization_usable",
    "digests_match",
    "approvals_active",
    "acceptance_criteria_complete",
    "prohibited_changes_complete",
    "codex_build_package_ready",
    "reasons",
    "package_grants_authority",
    "deployment_authorized",
    "production_change_authorized",
    "generated_at"
  ],
  "properties": {
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "codex_build_package_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/codexBuildPackageReference"
    },
    "implementation_brief_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationBriefReference"
    },
    "implementation_authorization_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationAuthorizationReference"
    },
    "package_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RELEASED",
        "SUPERSEDED"
      ]
    },
    "brief_ready": {
      "type": "boolean"
    },
    "implementation_authorization_usable": {
      "type": "boolean"
    },
    "digests_match": {
      "type": "boolean"
    },
    "approvals_active": {
      "type": "boolean"
    },
    "acceptance_criteria_complete": {
      "type": "boolean"
    },
    "prohibited_changes_complete": {
      "type": "boolean"
    },
    "codex_build_package_ready": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "PACKAGE_NOT_RELEASED",
          "BRIEF_NOT_READY",
          "IMPLEMENTATION_AUTHORIZATION_UNUSABLE",
          "DIGEST_MISMATCH",
          "APPROVAL_INVALID",
          "ACCEPTANCE_CRITERIA_INCOMPLETE",
          "PROHIBITED_CHANGES_INCOMPLETE",
          "PACKAGE_SUPERSEDED"
        ]
      }
    },
    "package_grants_authority": {
      "type": "boolean",
      "const": false
    },
    "deployment_authorized": {
      "type": "boolean",
      "const": false
    },
    "production_change_authorized": {
      "type": "boolean",
      "const": false
    },
    "generated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  }
}
