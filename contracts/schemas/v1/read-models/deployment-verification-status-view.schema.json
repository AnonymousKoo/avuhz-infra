{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:read-models:deployment-verification-status-view:v1",
  "title": "Deployment Verification Status View v1",
  "description": "Derived exact target-state verification result. Deployment is verified only when every authorized target matches the exact artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment_verification_reference",
    "deployment_execution_reference",
    "deployment_authorization_reference",
    "overall_status",
    "target_state_matches_authority",
    "deployment_verified",
    "rollback_required",
    "tenant_id",
    "engagement_id",
    "generated_at"
  ],
  "properties": {
    "deployment_verification_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-deployment-execution-common:v1#/$defs/deploymentVerificationReference"
    },
    "deployment_execution_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-deployment-execution-common:v1#/$defs/deploymentExecutionReference"
    },
    "deployment_authorization_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/deploymentAuthorizationReference"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "FAILED",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "target_state_matches_authority": {
      "type": "boolean"
    },
    "deployment_verified": {
      "type": "boolean"
    },
    "rollback_required": {
      "type": "boolean"
    },
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "generated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "target_state_matches_authority": {
            "const": true
          },
          "deployment_verified": {
            "const": true
          },
          "rollback_required": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "target_state_matches_authority": {
            "const": false
          },
          "deployment_verified": {
            "const": false
          },
          "rollback_required": {
            "const": true
          }
        }
      }
    }
  ]
}
