{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:read-models:implementation-brief-readiness-view:v1",
  "title": "Implementation Brief Readiness View v1",
  "description": "Tenant-bounded derived readiness from one exact current approved ImplementationHandoff and exact human approvals. No boolean creates implementation or deployment authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "engagement_id",
    "implementation_brief_reference",
    "implementation_handoff_reference",
    "source_truth_exact",
    "client_approval_active",
    "provider_approval_active",
    "implementation_brief_ready",
    "reasons",
    "implementation_authorized",
    "deployment_authorized",
    "production_change_authorized",
    "generated_at"
  ],
  "properties": {
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "implementation_brief_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationBriefReference"
    },
    "implementation_handoff_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationHandoffReference"
    },
    "source_truth_exact": {
      "type": "boolean"
    },
    "client_approval_active": {
      "type": "boolean"
    },
    "provider_approval_active": {
      "type": "boolean"
    },
    "implementation_brief_ready": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "BRIEF_NOT_APPROVED",
          "HANDOFF_SOURCE_MISMATCH",
          "CLIENT_APPROVAL_MISSING",
          "PROVIDER_APPROVAL_MISSING"
        ]
      }
    },
    "implementation_authorized": {
      "type": "boolean",
      "const": false
    },
    "deployment_authorized": {
      "type": "boolean",
      "const": false
    },
    "production_change_authorized": {
      "type": "boolean",
      "const": false
    },
    "generated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  }
}
