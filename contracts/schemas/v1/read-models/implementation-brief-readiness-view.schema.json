  "properties":{
    "tenant_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"},"engagement_id":{"$ref":"urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"},"implementation_brief_reference":{"$ref":"urn:avuhz:schema:contracts:domain:phase5d-common:v1#/$defs/implementationBriefReference"},
    "source_truth_exact":{"type":"boolean"},"conversion_accepted":{"type":"boolean"},"ongoing_agreement_active":{"type":"boolean"},"commercial_authority_valid":{"type":"boolean"},"ongoing_access_usable":{"type":"boolean"},"client_approval_active":{"type":"boolean"},"sekinfra_approval_active":{"type":"boolean"},"implementation_brief_ready":{"type":"boolean"},
