{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avuhz:schema:contracts:read-models:phase5d-delivery-progression-view:v1",
  "title": "Phase 5D Delivery Progression View v1",
  "description": "Non-collapsible derived progression ending at exact deployment authority, never deployment completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_reference",
    "stage",
    "package_released",
    "build_succeeded",
    "qa_passed",
    "client_accepted",
    "deployment_authorized",
    "deployment_completed",
    "blocking_reasons",
    "tenant_id",
    "engagement_id",
    "generated_at"
  ],
  "properties": {
    "package_reference": {
      "$ref": "urn:avuhz:schema:contracts:domain:phase5d-delivery-common:v1#/$defs/codexBuildPackageReference"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PACKAGE_RELEASED",
        "BUILD_IN_PROGRESS",
        "BUILD_FAILED",
        "BUILD_SUCCEEDED",
        "QA_FAILED",
        "QA_BLOCKED",
        "QA_PASSED",
        "CLIENT_REJECTED",
        "CLIENT_ACCEPTED",
        "DEPLOYMENT_PROPOSED",
        "DEPLOYMENT_AUTHORIZED",
        "DEPLOYMENT_BLOCKED"
      ]
    },
    "package_released": {
      "type": "boolean"
    },
    "build_succeeded": {
      "type": "boolean"
    },
    "qa_passed": {
      "type": "boolean"
    },
    "client_accepted": {
      "type": "boolean"
    },
    "deployment_authorized": {
      "type": "boolean"
    },
    "deployment_completed": {
      "const": false
    },
    "blocking_reasons": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
      }
    },
    "tenant_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/tenantId"
    },
    "engagement_id": {
      "$ref": "urn:avuhz:schema:contracts:common:identifiers:v1#/$defs/engagementId"
    },
    "generated_at": {
      "$ref": "urn:avuhz:schema:contracts:common:timestamps:v1#/$defs/utcTimestamp"
    }
  }
}
