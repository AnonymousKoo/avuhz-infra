\set ON_ERROR_STOP on
\getenv avuhz_runtime_login_password AVUHZ_RUNTIME_PASSWORD
select set_config('avuhz.runtime_login_password', :'avuhz_runtime_login_password', false) is not null as runtime_password_handoff_bound \gset
\unset avuhz_runtime_login_password
\ir development_data_runtime_login_v4.sql
select set_config('avuhz.runtime_login_password', '', false) = '' as runtime_password_handoff_cleared;
